{
  "$description": "LAYER 1 — Spacing. Edit spacing.grid.gutter-width for L/R page padding everywhere (pad = gutter / 2). Pairs with container/max-width.json via tels-content-width in paragon/overrides/_layout.scss.",
  "spacing": {
    "spacer": {
      "1": {
        "$value": "calc({spacing.spacer.base} * .25)",
        "$description": "Paragon default → --pgn-spacing-spacer-1"
      },
      "2": {
        "$value": "calc({spacing.spacer.base} * .5)",
        "$description": "Paragon default → --pgn-spacing-spacer-2"
      },
      "2.5": {
        "$value": "calc({spacing.spacer.base} * .75)",
        "$description": "Paragon default → --pgn-spacing-spacer-2-5"
      },
      "3.5": {
        "$value": "calc({spacing.spacer.base} * 1.25)",
        "$description": "Paragon default → --pgn-spacing-spacer-3-5"
      },
      "4": {
        "$value": "calc({spacing.spacer.base} * 1.5)",
        "$description": "Paragon default → --pgn-spacing-spacer-4"
      },
      "base": {
        "$value": "1rem",
        "$description": "Spacer base → --pgn-spacing-spacer-base"
      }
    },
    "grid": {
      "gutter-width": {
        "$value": "24px",
        "$description": "MAIN side padding control (change this) → --pgn-spacing-grid-gutter-width; L/R pad = half"
      }
    },
    "label": {
      "margin-bottom": {
        "$value": ".5rem",
        "$description": "Paragon default → --pgn-spacing-label-margin-bottom"
      }
    }
  }
}
