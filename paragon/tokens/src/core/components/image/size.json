{
  "$description": "image — Paragon defaults (copied from @openedx/paragon tokens; values unchanged). Edit here to change them for TitanEd.",
  "size": {
    "$type": "dimension",
    "image": {
      "thumbnail": {
        "border": {
          "radius": {
            "$value": "{size.border.radius.base}",
            "$description": "Paragon default → --pgn-size-image-thumbnail-border-radius"
          },
          "width": {
            "$value": "{size.border.width}",
            "$description": "Paragon default → --pgn-size-image-thumbnail-border-width"
          }
        }
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "image": {
      "thumbnail": {
        "padding": {
          "$value": ".25rem",
          "$description": "Paragon default → --pgn-spacing-image-thumbnail-padding"
        }
      }
    }
  },
  "typography": {
    "$type": "percentage",
    "image": {
      "figure-caption": {
        "font-size": {
          "$value": "90%",
          "$description": "Paragon default → --pgn-typography-image-figure-caption-font-size"
        }
      }
    }
  }
}
