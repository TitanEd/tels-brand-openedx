{
  "$description": "Button size / padding / radius for ALL variants (.btn, .btn-sm, .btn-lg) including ActionRow",
  "size": {
    "btn": {
      "border": {
        "width": {
          "$value": "{size.border.width}",
          "$description": "Button border width"
        },
        "radius": {
          "base": {
            "$value": "{size.border.radius.base}",
            "$description": "UI: Button radius → --pgn-size-btn-border-radius-base"
          },
          "sm": {
            "$value": "{size.border.radius.sm}",
            "$description": "UI: Button radius sm (.btn-sm) → --pgn-size-btn-border-radius-sm"
          },
          "lg": {
            "$value": "{size.border.radius.lg}",
            "$description": "UI: Button radius lg → --pgn-size-btn-border-radius-lg"
          }
        }
      },
      "focus": {
        "border-radius": {
          "base": {
            "$value": "calc({size.btn.border.radius.base} + {spacing.btn.focus.border-gap})",
            "$description": "Paragon default → --pgn-size-btn-focus-border-radius-base"
          },
          "lg": {
            "$value": "{size.btn.focus.border-radius.base}",
            "$description": "Paragon default → --pgn-size-btn-focus-border-radius-lg"
          },
          "sm": {
            "$value": "{size.btn.border.radius.base}",
            "$description": "Paragon default → --pgn-size-btn-focus-border-radius-sm"
          }
        },
        "width": {
          "$value": "2px",
          "$description": "Paragon default → --pgn-size-btn-focus-width"
        }
      }
    }
  },
  "spacing": {
    "btn": {
      "padding": {
        "x": {
          "base": {
            "$value": "{spacing.input.btn.padding.x}",
            "$description": "UI: Button padding X → --pgn-spacing-btn-padding-x-base"
          },
          "sm": {
            "$value": "{spacing.input.btn.padding.sm.x}",
            "$description": "UI: Button padding X sm → --pgn-spacing-btn-padding-x-sm"
          },
          "lg": {
            "$value": "{spacing.input.btn.padding.lg.x}",
            "$description": "UI: Button padding X lg → --pgn-spacing-btn-padding-x-lg"
          }
        },
        "y": {
          "base": {
            "$value": "{spacing.input.btn.padding.y}",
            "$description": "UI: Button padding Y → --pgn-spacing-btn-padding-y-base"
          },
          "sm": {
            "$value": "{spacing.input.btn.padding.sm.y}",
            "$description": "UI: Button padding Y sm → --pgn-spacing-btn-padding-y-sm"
          },
          "lg": {
            "$value": "{spacing.input.btn.padding.lg.y}",
            "$description": "UI: Button padding Y lg → --pgn-spacing-btn-padding-y-lg"
          }
        }
      },
      "icon": {
        "gap": {
          "$value": "0.5rem",
          "$type": "dimension",
          "$description": "UI: Space between button label and iconBefore / iconAfter → --pgn-spacing-btn-icon-gap (Paragon stock .5rem). Applied by overrides/_buttons.scss."
        }
      },
      "focus": {
        "distance-to-border": {
          "$value": "calc({spacing.btn.focus.border-gap} + {size.btn.border.width})",
          "$description": "Paragon default → --pgn-spacing-btn-focus-distance-to-border"
        }
      }
    }
  },
  "typography": {
    "btn": {
      "font": {
        "size": {
          "base": {
            "$value": "{typography.input.btn.font.size.base}",
            "$description": "UI: Button font size → --pgn-typography-btn-font-size-base"
          },
          "sm": {
            "$value": "{typography.input.btn.font.size.sm}",
            "$description": "UI: Button font size sm → --pgn-typography-btn-font-size-sm"
          },
          "lg": {
            "$value": "{typography.input.btn.font.size.lg}",
            "$description": "UI: Button font size lg → --pgn-typography-btn-font-size-lg"
          }
        },
        "weight": {
          "$value": "{typography.font.weight.normal}",
          "$type": "fontWeight",
          "$description": "UI: Button font weight (all variants) → --pgn-typography-btn-font-weight"
        },
        "family": {
          "$value": "{typography.input.btn.font.family}",
          "$type": "fontFamily",
          "$description": "Paragon default → --pgn-typography-btn-font-family"
        }
      },
      "line-height": {
        "base": {
          "$value": "{typography.input.btn.line-height.base}",
          "$description": "Paragon default → --pgn-typography-btn-line-height-base"
        },
        "lg": {
          "$value": "{typography.input.btn.line-height.lg}",
          "$description": "Paragon default → --pgn-typography-btn-line-height-lg"
        },
        "sm": {
          "$value": "{typography.input.btn.line-height.sm}",
          "$description": "Paragon default → --pgn-typography-btn-line-height-sm"
        }
      }
    }
  },
  "transition": {
    "btn": {
      "$value": "none",
      "$description": "Paragon default → --pgn-transition-btn"
    }
  }
}
