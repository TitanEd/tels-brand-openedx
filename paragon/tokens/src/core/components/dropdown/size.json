{
  "$description": "dropdown — Paragon defaults (copied from @openedx/paragon tokens; values unchanged). Edit here to change them for TitanEd.",
  "elevation": {
    "$type": "number",
    "dropdown": {
      "zindex": {
        "$value": "1000",
        "$description": "Paragon default → --pgn-elevation-dropdown-zindex"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "dropdown": {
      "border": {
        "radius": {
          "base": {
            "$value": "{size.border.radius.base}",
            "$description": "Paragon default → --pgn-size-dropdown-border-radius-base"
          }
        },
        "width": {
          "$value": "{size.border.width}",
          "$description": "Paragon default → --pgn-size-dropdown-border-width"
        }
      },
      "min-width": {
        "$value": "18rem",
        "$description": "Paragon default → --pgn-size-dropdown-min-width"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "dropdown": {
      "close-container": {
        "top": {
          "$value": ".625rem",
          "$description": "Paragon default → --pgn-spacing-dropdown-close-container-top"
        }
      },
      "padding": {
        "header": {
          "$value": {
            "x": "{spacing.dropdown.padding.x.item}",
            "y": ".5rem"
          },
          "$description": "Paragon default → --pgn-spacing-dropdown-padding-header"
        },
        "x": {
          "base": {
            "$value": "0",
            "$description": "Paragon default → --pgn-spacing-dropdown-padding-x-base"
          },
          "item": {
            "$value": "1rem",
            "$description": "Paragon default → --pgn-spacing-dropdown-padding-x-item"
          }
        },
        "y": {
          "base": {
            "$value": ".5rem",
            "$description": "Paragon default → --pgn-spacing-dropdown-padding-y-base"
          },
          "item": {
            "$value": ".25rem",
            "$description": "Paragon default → --pgn-spacing-dropdown-padding-y-item"
          }
        }
      },
      "spacer": {
        "$value": ".125rem",
        "$description": "Paragon default → --pgn-spacing-dropdown-spacer"
      }
    }
  },
  "typography": {
    "dropdown": {
      "font-size": {
        "$value": "{typography.font.size.base}",
        "$type": "dimension",
        "$description": "Paragon default → --pgn-typography-dropdown-font-size"
      },
      "item": {
        "text-decoration": {
          "$value": "none",
          "$description": "Paragon default → --pgn-typography-dropdown-item-text-decoration"
        }
      }
    }
  }
}
