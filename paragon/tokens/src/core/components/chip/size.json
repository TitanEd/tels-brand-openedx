{
  "$description": "CHIP — component-level size tokens (class: .pgn__chip). Radius defaults to global base radius (cascades), independently overridable here.",
  "size": {
    "chip": {
      "border-radius": {
        "$value": "{size.border.radius.base}",
        "$description": "Chip radius → --pgn-size-chip-border-radius"
      },
      "icon": {
        "$value": "1.5rem",
        "$description": "Paragon default → --pgn-size-chip-icon"
      }
    }
  },
  "spacing": {
    "chip": {
      "padding": {
        "x": {
          "$value": ".5rem",
          "$description": "Chip padding X → --pgn-spacing-chip-padding-x"
        },
        "y": {
          "$value": "1px",
          "$description": "Chip padding Y → --pgn-spacing-chip-padding-y"
        }
      },
      "margin": {
        "base": {
          "$value": ".125rem",
          "$description": "Chip margin → --pgn-spacing-chip-margin-base"
        },
        "icon": {
          "$value": ".25rem",
          "$description": "Paragon default → --pgn-spacing-chip-margin-icon"
        }
      },
      "outline": {
        "selected-distance": {
          "dark": {
            "$value": "3px",
            "$description": "Paragon default → --pgn-spacing-chip-outline-selected-distance-dark"
          },
          "light": {
            "$value": "3px",
            "$description": "Paragon default → --pgn-spacing-chip-outline-selected-distance-light"
          }
        },
        "width": {
          "$value": "3px",
          "$description": "Paragon default → --pgn-spacing-chip-outline-width"
        }
      }
    }
  }
}
