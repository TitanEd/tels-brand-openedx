{
  "$description": "form — Paragon defaults (copied from @openedx/paragon tokens; values unchanged). Edit here to change them for TitanEd.",
  "spacing": {
    "$type": "dimension",
    "form": {
      "check": {
        "position": {
          "axis": {
            "$value": ".375rem",
            "$description": "Paragon default → --pgn-spacing-form-check-position-axis"
          }
        }
      },
      "control": {
        "gutter": {
          "$value": ".5rem",
          "$description": "Paragon default → --pgn-spacing-form-control-gutter"
        },
        "select": {
          "icon": {
            "padding": {
              "$value": ".5625rem",
              "$description": "Paragon default → --pgn-spacing-form-control-select-icon-padding"
            }
          }
        }
      },
      "group": {
        "margin": {
          "bottom": {
            "$value": "1rem",
            "$description": "Paragon default → --pgn-spacing-form-group-margin-bottom"
          }
        }
      },
      "input": {
        "padding": {
          "x": {
            "base": {
              "$value": "{spacing.input.btn.padding.x}",
              "$description": "Paragon default → --pgn-spacing-form-input-padding-x-base"
            }
          },
          "y": {
            "base": {
              "$value": "{spacing.input.btn.padding.y}",
              "$description": "Paragon default → --pgn-spacing-form-input-padding-y-base"
            },
            "sm": {
              "$value": "{spacing.input.btn.padding.sm.y}",
              "$description": "Paragon default → --pgn-spacing-form-input-padding-y-sm"
            }
          }
        }
      }
    }
  }
}
