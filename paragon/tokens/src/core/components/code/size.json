{
  "$description": "code — Paragon defaults (copied from @openedx/paragon tokens; values unchanged). Edit here to change them for TitanEd.",
  "typography": {
    "code": {
      "font-size": {
        "$value": "{typography.font.size.sm}",
        "$type": "percentage",
        "$description": "Paragon default → --pgn-typography-code-font-size"
      },
      "kbd": {
        "font-size": {
          "$value": "{typography.code.font-size}",
          "$type": "dimension",
          "$description": "Paragon default → --pgn-typography-code-kbd-font-size"
        }
      }
    }
  },
  "spacing": {
    "code": {
      "kbd": {
        "padding": {
          "x": {
            "$value": ".4rem",
            "$description": "Paragon default → --pgn-spacing-code-kbd-padding-x"
          },
          "y": {
            "$value": ".2rem",
            "$description": "Paragon default → --pgn-spacing-code-kbd-padding-y"
          }
        }
      }
    }
  }
}
