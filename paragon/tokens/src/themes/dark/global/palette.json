{
  "$type": "color",
  "$description": "LAYER 1 — Dark neutral scales. Paragon only ships light scales (gray-700 = dark text, gray-100 = light surface), so on the dark page the scales run the other way: low numbers are dark surfaces, high numbers are light text. Components that use var(--pgn-color-gray-*) / light-* follow automatically. The dark scale runs the other way too: MFEs use text-dark / text-dark-700 for text, so color.dark.base and dark-600…900 are light, dark-100…400 are dark surfaces.",
  "color": {
    "gray": {
      "100": {
        "$value": "#1F2937",
        "$description": "Dark gray 100 — subtle surface (hover rows, disabled inputs) → --pgn-color-gray-100"
      },
      "200": {
        "$value": "#374151",
        "$description": "Dark gray 200 — borders and dividers → --pgn-color-gray-200"
      },
      "300": {
        "$value": "#4B5563",
        "$description": "Dark gray 300 — strong borders → --pgn-color-gray-300"
      },
      "400": {
        "$value": "#6B7280",
        "$description": "Dark gray 400 — disabled text → --pgn-color-gray-400"
      },
      "500": {
        "$value": "{color.gray.base}",
        "$description": "Dark gray 500 — muted text, placeholders, input borders → --pgn-color-gray-500"
      },
      "600": {
        "$value": "#B7BDC6",
        "$description": "Dark gray 600 — secondary text → --pgn-color-gray-600"
      },
      "700": {
        "$value": "#D1D5DB",
        "$description": "Dark gray 700 — input text, tab text, tertiary labels → --pgn-color-gray-700"
      },
      "800": {
        "$value": "#E5E7EB",
        "$description": "Dark gray 800 — strong text → --pgn-color-gray-800"
      },
      "900": {
        "$value": "#F3F4F6",
        "$description": "Dark gray 900 — strongest text → --pgn-color-gray-900"
      },
      "base": {
        "$value": "#9CA3AF",
        "$description": "Dark gray base — basic gray on dark → --pgn-color-gray-base"
      }
    },
    "light": {
      "100": {
        "$value": "#172030",
        "modify": null,
        "$description": "Dark \"light\" 100 (muted surface scale) → --pgn-color-light-100"
      },
      "200": {
        "$value": "#1F2937",
        "modify": null,
        "$description": "Dark \"light\" 200 (muted surface scale) → --pgn-color-light-200"
      },
      "300": {
        "$value": "#2B3544",
        "modify": null,
        "$description": "Dark \"light\" 300 (muted surface scale) → --pgn-color-light-300"
      },
      "400": {
        "$value": "#313B4A",
        "modify": null,
        "$description": "Dark \"light\" 400 (muted surface scale) → --pgn-color-light-400"
      },
      "500": {
        "$value": "{color.light.base}",
        "$description": "Dark \"light\" 500 = color.light.base → --pgn-color-light-500"
      },
      "600": {
        "$value": "#4B5563",
        "modify": null,
        "$description": "Dark \"light\" 600 (muted surface scale) → --pgn-color-light-600"
      },
      "700": {
        "$value": "#6B7280",
        "modify": null,
        "$description": "Dark \"light\" 700 (muted surface scale) → --pgn-color-light-700"
      },
      "800": {
        "$value": "#9CA3AF",
        "modify": null,
        "$description": "Dark \"light\" 800 (muted surface scale) → --pgn-color-light-800"
      },
      "900": {
        "$value": "#D1D5DB",
        "modify": null,
        "$description": "Dark \"light\" 900 (muted surface scale) → --pgn-color-light-900"
      }
    },
    "dark": {
      "100": {
        "$value": "#1F2937",
        "modify": null,
        "$description": "Dark \"dark\" 100 — dark chrome (backdrop of inverse buttons) → --pgn-color-dark-100"
      },
      "200": {
        "$value": "#374151",
        "modify": null,
        "$description": "Dark \"dark\" 200 — borders → --pgn-color-dark-200"
      },
      "300": {
        "$value": "#4B5563",
        "modify": null,
        "$description": "Dark \"dark\" 300 — strong borders → --pgn-color-dark-300"
      },
      "400": {
        "$value": "#6B7280",
        "modify": null,
        "$description": "Dark \"dark\" 400 — muted → --pgn-color-dark-400"
      },
      "500": {
        "$value": "{color.dark.base}",
        "modify": null,
        "$description": "Dark \"dark\" 500 — = color.dark.base → --pgn-color-dark-500"
      },
      "600": {
        "$value": "#C4C9D1",
        "modify": null,
        "$description": "Dark \"dark\" 600 — focus ring for dark → --pgn-color-dark-600"
      },
      "700": {
        "$value": "#D1D5DB",
        "modify": null,
        "$description": "Dark \"dark\" 700 — body-level text (Learning uses text-dark-700) → --pgn-color-dark-700"
      },
      "800": {
        "$value": "#E5E7EB",
        "modify": null,
        "$description": "Dark \"dark\" 800 — strong text → --pgn-color-dark-800"
      },
      "900": {
        "$value": "#F3F4F6",
        "modify": null,
        "$description": "Dark \"dark\" 900 — strongest text → --pgn-color-dark-900"
      },
      "base": {
        "$value": "#B7BDC6",
        "modify": null,
        "$description": "Dark \"dark\" base — light neutral text (text-dark, Learning section titles); bg-dark and btn-dark are light surfaces with dark labels → --pgn-color-dark-base"
      }
    },
    "theme": {
      "bg": {
        "primary": {
          "$value": "{color.primary.base}",
          "modify": [
            {
              "type": "mix",
              "otherColor": "#111827",
              "amount": "0.8"
            }
          ],
          "$description": "Tinted dark surface for primary (alerts, highlights): primary mixed 80% into the page color → --pgn-color-theme-bg-primary"
        },
        "secondary": {
          "$value": "{color.secondary.base}",
          "modify": [
            {
              "type": "mix",
              "otherColor": "#111827",
