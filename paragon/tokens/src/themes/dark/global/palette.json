        },
        "gray": {
          "$value": "{color.gray.100}",
          "$description": "Tinted dark surface for gray → --pgn-color-theme-bg-gray"
        }
      },
      "focus": {
        "secondary": {
          "$value": "{color.secondary.300}",
          "$description": "Focus ring for secondary on dark (secondary.base is too dark to see) → --pgn-color-theme-focus-secondary"
        },
        "dark": {
          "$value": "{color.dark.600}",
          "$description": "Focus ring for dark on dark (dark.base is the dark chrome itself, too close to the page) → --pgn-color-theme-focus-dark"
        },
        "light": {
          "$value": "{color.gray.500}",
          "$description": "Focus ring for light on dark → --pgn-color-theme-focus-light"
