              "amount": "0.8"
            }
          ],
          "$description": "Tinted dark surface for warning (alerts, highlights): warning mixed 80% into the page color → --pgn-color-theme-bg-warning"
        },
        "danger": {
          "$value": "{color.danger.base}",
          "modify": [
