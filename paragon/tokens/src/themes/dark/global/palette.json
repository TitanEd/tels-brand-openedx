          "modify": [
            {
              "type": "mix",
              "otherColor": "#111827",
              "amount": "0.8"
            }
          ],
          "$description": "Tinted dark surface for primary (alerts, highlights): primary mixed 80% into the page color \u2192 --pgn-color-theme-bg-primary"
        },
        "secondary": {
