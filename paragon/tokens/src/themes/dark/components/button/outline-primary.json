{
  "$description": "Dark — outline primary. Labels readable on the dark page (modify:null).",
  "color": {
    "btn": {
      "bg": {
        "outline-primary": {
          "$value": "transparent",
          "$description": "bg (dark) → --pgn-color-btn-bg-outline-primary"
        }
      },
      "text": {
        "outline-primary": {
          "$value": "{color.primary.base}",
          "modify": null,
          "$description": "text (dark) → --pgn-color-btn-text-outline-primary"
        }
      },
      "border": {
        "outline-primary": {
          "$value": "{color.primary.base}",
          "$description": "border (dark) → --pgn-color-btn-border-outline-primary"
        }
      },
      "hover": {
        "bg": {
          "outline-primary": {
            "$value": "transparent",
            "$description": "Hover bg (dark) → --pgn-color-btn-hover-bg-outline-primary"
          }
        },
        "text": {
          "outline-primary": {
            "$value": "{color.primary.400}",
            "modify": null,
            "$description": "Hover text (dark) → --pgn-color-btn-hover-text-outline-primary"
          }
        },
        "border": {
          "outline-primary": {
            "$value": "{color.primary.400}",
            "$description": "Hover border (dark) → --pgn-color-btn-hover-border-outline-primary"
          }
        }
      },
      "active": {
        "bg": {
          "outline-primary": {
            "$value": "transparent",
            "$description": "Active bg (dark) → --pgn-color-btn-active-bg-outline-primary"
          }
        },
        "text": {
          "outline-primary": {
            "$value": "{color.primary.300}",
            "modify": null,
            "$description": "Active text (dark) → --pgn-color-btn-active-text-outline-primary"
          }
        },
        "border": {
          "outline-primary": {
            "$value": "{color.primary.300}",
            "$description": "Active border (dark) → --pgn-color-btn-active-border-outline-primary"
          }
        }
      },
      "disabled": {
        "bg": {
          "outline-primary": {
            "$value": "transparent",
            "$description": "Disabled bg (dark) → --pgn-color-btn-disabled-bg-outline-primary"
          }
        },
        "text": {
          "outline-primary": {
            "$value": "{color.btn.text.outline-primary}",
            "modify": null,
            "$description": "Disabled text (dark) → --pgn-color-btn-disabled-text-outline-primary"
          }
        },
        "border": {
          "outline-primary": {
            "$value": "{color.btn.border.outline-primary}",
            "$description": "Disabled border (dark) → --pgn-color-btn-disabled-border-outline-primary"
          }
        }
      },
      "focus": {
        "bg": {
          "outline-primary": {
            "$value": "inherit",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-bg-outline-primary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "border": {
          "outline-primary": {
            "$value": "{color.btn.border.outline-primary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-border-outline-primary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "outline": {
          "outline-primary": {
            "$value": "{color.theme.focus.primary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-outline-outline-primary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "text": {
          "outline-primary": {
            "$value": "{color.btn.text.outline-primary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-text-outline-primary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        }
      }
    }
  }
}
