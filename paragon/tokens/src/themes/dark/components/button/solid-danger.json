{
  "$description": "Dark — solid danger. White labels use modify:null.",
  "color": {
    "btn": {
      "bg": {
        "danger": {
          "$value": "{color.danger.base}",
          "$description": "bg (dark) → --pgn-color-btn-bg-danger"
        }
      },
      "text": {
        "danger": {
          "$value": "{color.text.inverse}",
          "modify": null,
          "$description": "text (dark) → --pgn-color-btn-text-danger"
        }
      },
      "border": {
        "danger": {
          "$value": "{color.btn.bg.danger}",
          "$description": "border (dark) → --pgn-color-btn-border-danger"
        }
      },
      "hover": {
        "bg": {
          "danger": {
            "$value": "{color.theme.hover.danger}",
            "$description": "Hover bg (dark) → --pgn-color-btn-hover-bg-danger"
          }
        },
        "text": {
          "danger": {
            "$value": "{color.text.inverse}",
            "modify": null,
            "$description": "Hover text (dark) → --pgn-color-btn-hover-text-danger"
          }
        },
        "border": {
          "danger": {
            "$value": "{color.theme.hover.danger}",
            "$description": "Hover border (dark) → --pgn-color-btn-hover-border-danger"
          }
        }
      },
      "active": {
        "bg": {
          "danger": {
            "$value": "{color.theme.active.danger}",
            "$description": "Active bg (dark) → --pgn-color-btn-active-bg-danger"
          }
        },
        "text": {
          "danger": {
            "$value": "{color.text.inverse}",
            "modify": null,
            "$description": "Active text (dark) → --pgn-color-btn-active-text-danger"
          }
        },
        "border": {
          "danger": {
            "$value": "{color.theme.active.danger}",
            "$description": "Active border (dark) → --pgn-color-btn-active-border-danger"
          }
        }
      },
      "disabled": {
        "bg": {
          "danger": {
            "$value": "{color.btn.bg.danger}",
            "$description": "Disabled bg (dark) → --pgn-color-btn-disabled-bg-danger"
          }
        },
        "text": {
          "danger": {
            "$value": "{color.btn.text.danger}",
            "modify": null,
            "$description": "Disabled text (dark) → --pgn-color-btn-disabled-text-danger"
          }
        },
        "border": {
          "danger": {
            "$value": "{color.btn.border.danger}",
            "$description": "Disabled border (dark) → --pgn-color-btn-disabled-border-danger"
          }
        }
      },
      "focus": {
        "bg": {
          "danger": {
            "$value": "{color.btn.bg.danger}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-bg-danger",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "border": {
          "danger": {
            "$value": "{color.btn.focus.bg.danger}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-border-danger",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "outline": {
          "danger": {
            "$value": "{color.theme.focus.danger}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-outline-danger",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "text": {
          "danger": {
            "$value": "{color.btn.text.danger}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-text-danger",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        }
      }
    }
  }
}
