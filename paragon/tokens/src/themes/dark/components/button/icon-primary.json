{
  "$description": "Dark — IconButton primary. White icon on the filled hover / pressed state (modify:null).",
  "color": {
    "icon-button": {
      "text": {
        "primary": {
          "base": {
            "$value": "{color.primary.base}",
            "$description": "Icon (dark) → --pgn-color-icon-button-text-primary-base"
          },
          "hover": {
            "$value": "{color.text.inverse}",
            "modify": null,
            "$description": "Icon on hover (dark) → --pgn-color-icon-button-text-primary-hover"
          },
          "active": {
            "base": {
              "$value": "{color.text.inverse}",
              "modify": null,
              "$description": "Icon pressed (dark) → --pgn-color-icon-button-text-primary-active-base"
            },
            "hover": {
              "$value": "{color.text.inverse}",
              "modify": null,
              "$description": "Icon pressed + hover (dark) → --pgn-color-icon-button-text-primary-active-hover"
            },
            "focus": {
              "$value": "{color.text.inverse}",
              "modify": null,
              "$description": "Icon pressed + focus (dark) → --pgn-color-icon-button-text-primary-active-focus"
            }
          },
          "focus": {
            "$value": "{color.icon-button.text.primary.base}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-icon-button-text-primary-focus",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          },
          "inverse": {
            "base": {
              "$value": "{color.icon-button.accent}",
              "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-icon-button-text-primary-inverse-base",
              "$extensions": {
                "tels": {
                  "syncedFromLight": true
                }
              }
            },
            "focus": {
              "$value": "{color.icon-button.accent}",
              "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-icon-button-text-primary-inverse-focus",
              "$extensions": {
                "tels": {
                  "syncedFromLight": true
                }
              }
            },
            "hover": {
              "$value": "{color.icon-button.text.primary.base}",
              "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-icon-button-text-primary-inverse-hover",
              "$extensions": {
                "tels": {
                  "syncedFromLight": true
                }
              }
            }
          }
        }
      },
      "bg": {
        "primary": {
          "hover": {
            "$value": "{color.primary.base}",
            "$description": "Hover fill (dark) → --pgn-color-icon-button-bg-primary-hover"
          },
          "active": {
            "base": {
              "$value": "{color.primary.base}",
              "$description": "Pressed fill (dark) → --pgn-color-icon-button-bg-primary-active-base"
            },
            "focus": {
              "$value": "{color.icon-button.text.primary.base}",
              "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-icon-button-bg-primary-active-focus",
              "$extensions": {
                "tels": {
                  "syncedFromLight": true
                }
              }
            },
            "hover": {
              "$value": "{color.icon-button.text.primary.base}",
              "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-icon-button-bg-primary-active-hover",
              "$extensions": {
                "tels": {
                  "syncedFromLight": true
                }
              }
            }
          },
          "base": {
            "$value": "{color.icon-button.bg.base}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-icon-button-bg-primary-base",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          },
          "focus": {
            "$value": "{color.icon-button.bg.base}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-icon-button-bg-primary-focus",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          },
          "inverse": {
            "base": {
              "$value": "{color.icon-button.bg.base}",
              "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-icon-button-bg-primary-inverse-base",
              "$extensions": {
                "tels": {
                  "syncedFromLight": true
                }
              }
            },
            "focus": {
              "$value": "{color.icon-button.bg.base}",
              "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-icon-button-bg-primary-inverse-focus",
              "$extensions": {
                "tels": {
                  "syncedFromLight": true
                }
              }
            },
            "hover": {
              "$value": "{color.icon-button.accent}",
              "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-icon-button-bg-primary-inverse-hover",
              "$extensions": {
                "tels": {
                  "syncedFromLight": true
                }
              }
            }
          }
        }
      },
      "accent": {
        "$value": "{color.text.inverse}",
        "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-icon-button-accent",
        "$extensions": {
          "tels": {
            "syncedFromLight": true
          }
        }
      }
    }
  },
  "elevation": {
    "icon-button": {
      "box-shadow": {
        "primary": {
          "active": {
            "$value": "none",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-elevation-icon-button-box-shadow-primary-active",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          },
          "base": {
            "$value": {
              "color": "{color.icon-button.text.primary.base}",
              "spread": "{size.btn.focus.width}",
              "offsetX": "0",
              "offsetY": "0",
              "blur": "0",
              "inset": "inset"
            },
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-elevation-icon-button-box-shadow-primary-base",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          },
          "inverse": {
            "$value": {
              "color": "{color.icon-button.accent}",
              "spread": "{size.btn.focus.width}",
              "offsetX": "0",
              "offsetY": "0",
              "blur": "0",
              "inset": "inset"
            },
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-elevation-icon-button-box-shadow-primary-inverse",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        }
      }
    }
  }
}
