{
  "$description": "Dark — solid dark. White labels use modify:null.",
  "color": {
    "btn": {
      "bg": {
        "dark": {
          "$value": "{color.dark.base}",
          "$description": "bg (dark) → --pgn-color-btn-bg-dark"
        }
      },
      "text": {
        "dark": {
          "$value": "{color.bg.base}",
          "modify": null,
          "$description": "text (dark) → --pgn-color-btn-text-dark"
        }
      },
      "border": {
        "dark": {
          "$value": "{color.btn.bg.dark}",
          "$description": "border (dark) → --pgn-color-btn-border-dark"
        }
      },
      "hover": {
        "bg": {
          "dark": {
            "$value": "{color.dark.700}",
            "$description": "Hover bg (dark) → --pgn-color-btn-hover-bg-dark"
          }
        },
        "text": {
          "dark": {
            "$value": "{color.bg.base}",
            "modify": null,
            "$description": "Hover text (dark) → --pgn-color-btn-hover-text-dark"
          }
        },
        "border": {
          "dark": {
            "$value": "{color.dark.700}",
            "$description": "Hover border (dark) → --pgn-color-btn-hover-border-dark"
          }
        }
      },
      "active": {
        "bg": {
          "dark": {
            "$value": "{color.dark.800}",
            "$description": "Active bg (dark) → --pgn-color-btn-active-bg-dark"
          }
        },
        "text": {
          "dark": {
            "$value": "{color.bg.base}",
            "modify": null,
            "$description": "Active text (dark) → --pgn-color-btn-active-text-dark"
          }
        },
        "border": {
          "dark": {
            "$value": "{color.dark.800}",
            "$description": "Active border (dark) → --pgn-color-btn-active-border-dark"
          }
        }
      },
      "disabled": {
        "bg": {
          "dark": {
            "$value": "{color.btn.bg.dark}",
            "$description": "Disabled bg (dark) → --pgn-color-btn-disabled-bg-dark"
          }
        },
        "text": {
          "dark": {
            "$value": "{color.btn.text.dark}",
            "modify": null,
            "$description": "Disabled text (dark) → --pgn-color-btn-disabled-text-dark"
          }
        },
        "border": {
          "dark": {
            "$value": "{color.btn.border.dark}",
            "$description": "Disabled border (dark) → --pgn-color-btn-disabled-border-dark"
          }
        }
      },
      "focus": {
        "bg": {
          "dark": {
            "$value": "{color.btn.bg.dark}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-bg-dark",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "border": {
          "dark": {
            "$value": "{color.btn.focus.bg.dark}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-border-dark",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "outline": {
          "dark": {
            "$value": "{color.theme.focus.dark}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-outline-dark",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "text": {
          "dark": {
            "$value": "{color.btn.text.dark}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-text-dark",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        }
      }
    }
  }
}
