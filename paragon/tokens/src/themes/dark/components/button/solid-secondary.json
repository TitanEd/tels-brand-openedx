{
  "$description": "Dark — solid secondary. Cascades from Layer 1 color.secondary.base. White labels use modify:null.",
  "color": {
    "btn": {
      "bg": {
        "secondary": {
          "$value": "{color.secondary.base}",
          "$description": "Solid secondary bg (dark) → --pgn-color-btn-bg-secondary"
        }
      },
      "text": {
        "secondary": {
          "$value": "{color.text.inverse}",
          "modify": null,
          "$description": "Solid secondary text (dark) → --pgn-color-btn-text-secondary"
        }
      },
      "border": {
        "secondary": {
          "$value": "{color.btn.bg.secondary}",
          "$description": "Solid secondary border (dark)"
        }
      },
      "hover": {
        "bg": {
          "secondary": {
            "$value": "{color.theme.hover.secondary}",
            "$description": "Hover bg (dark) → --pgn-color-btn-hover-bg-secondary"
          }
        },
        "text": {
          "secondary": {
            "$value": "{color.text.inverse}",
            "modify": null,
            "$description": "Hover text (dark)"
          }
        },
        "border": {
          "secondary": {
            "$value": "{color.theme.hover.secondary}",
            "$description": "Hover border (dark)"
          }
        }
      },
      "active": {
        "bg": {
          "secondary": {
            "$value": "{color.theme.active.secondary}",
            "$description": "Active bg (dark)"
          }
        },
        "text": {
          "secondary": {
            "$value": "{color.text.inverse}",
            "modify": null,
            "$description": "Active text (dark)"
          }
        },
        "border": {
          "secondary": {
            "$value": "{color.theme.active.secondary}",
            "$description": "Active border (dark)"
          }
        }
      },
      "disabled": {
        "bg": {
          "secondary": {
            "$value": "{color.btn.bg.secondary}",
            "$description": "Disabled bg (dark)"
          }
        },
        "text": {
          "secondary": {
            "$value": "{color.btn.text.secondary}",
            "modify": null,
            "$description": "Disabled text (dark)"
          }
        },
        "border": {
          "secondary": {
            "$value": "{color.btn.border.secondary}",
            "$description": "Disabled border (dark)"
          }
        }
      },
      "focus": {
        "bg": {
          "secondary": {
            "$value": "{color.btn.bg.secondary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-bg-secondary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "border": {
          "secondary": {
            "$value": "{color.btn.bg.secondary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-border-secondary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "outline": {
          "secondary": {
            "$value": "{color.theme.focus.secondary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-outline-secondary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "text": {
          "secondary": {
            "$value": "{color.btn.text.secondary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-text-secondary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        }
      }
    }
  }
}
