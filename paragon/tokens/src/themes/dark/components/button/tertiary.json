{
  "$description": "Dark — tertiary (text button). Uses the dark gray scale.",
  "color": {
    "btn": {
      "bg": {
        "tertiary": {
          "$value": "transparent",
          "$description": "bg (dark) → --pgn-color-btn-bg-tertiary"
        }
      },
      "text": {
        "tertiary": {
          "$value": "{color.gray.700}",
          "modify": null,
          "$description": "text (dark) → --pgn-color-btn-text-tertiary"
        }
      },
      "border": {
        "tertiary": {
          "$value": "transparent",
          "$description": "border (dark) → --pgn-color-btn-border-tertiary"
        }
      },
      "hover": {
        "bg": {
          "tertiary": {
            "$value": "{color.light.500}",
            "$description": "Hover bg (dark) → --pgn-color-btn-hover-bg-tertiary"
          }
        },
        "text": {
          "tertiary": {
            "$value": "{color.gray.700}",
            "modify": null,
            "$description": "Hover text (dark) → --pgn-color-btn-hover-text-tertiary"
          }
        },
        "border": {
          "tertiary": {
            "$value": "transparent",
            "$description": "Hover border (dark) → --pgn-color-btn-hover-border-tertiary"
          }
        }
      },
      "active": {
        "bg": {
          "tertiary": {
            "$value": "{color.light.500}",
            "$description": "Active bg (dark) → --pgn-color-btn-active-bg-tertiary"
          }
        },
        "text": {
          "tertiary": {
            "$value": "{color.gray.700}",
            "modify": null,
            "$description": "Active text (dark) → --pgn-color-btn-active-text-tertiary"
          }
        },
        "border": {
          "tertiary": {
            "$value": "transparent",
            "$description": "Active border (dark) → --pgn-color-btn-active-border-tertiary"
          }
        }
      },
      "disabled": {
        "bg": {
          "tertiary": {
            "$value": "transparent",
            "$description": "Disabled bg (dark) → --pgn-color-btn-disabled-bg-tertiary"
          }
        },
        "text": {
          "tertiary": {
            "$value": "{color.btn.text.tertiary}",
            "modify": null,
            "$description": "Disabled text (dark) → --pgn-color-btn-disabled-text-tertiary"
          }
        },
        "border": {
          "tertiary": {
            "$value": "transparent",
            "$description": "Disabled border (dark) → --pgn-color-btn-disabled-border-tertiary"
          }
        }
      },
      "focus": {
        "bg": {
          "tertiary": {
            "$value": "inherit",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-bg-tertiary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "border": {
          "tertiary": {
            "$value": "{color.btn.border.tertiary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-border-tertiary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "outline": {
          "tertiary": {
            "$value": "{color.theme.focus.primary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-outline-tertiary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "text": {
          "tertiary": {
            "$value": "{color.btn.text.tertiary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-text-tertiary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        }
      }
    }
  }
}
