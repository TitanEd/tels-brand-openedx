{
  "$description": "Dark — solid success. White labels use modify:null.",
  "color": {
    "btn": {
      "bg": {
        "success": {
          "$value": "{color.success.base}",
          "$description": "bg (dark) → --pgn-color-btn-bg-success"
        }
      },
      "text": {
        "success": {
          "$value": "{color.text.inverse}",
          "modify": null,
          "$description": "text (dark) → --pgn-color-btn-text-success"
        }
      },
      "border": {
        "success": {
          "$value": "{color.btn.bg.success}",
          "$description": "border (dark) → --pgn-color-btn-border-success"
        }
      },
      "hover": {
        "bg": {
          "success": {
            "$value": "{color.theme.hover.success}",
            "$description": "Hover bg (dark) → --pgn-color-btn-hover-bg-success"
          }
        },
        "text": {
          "success": {
            "$value": "{color.text.inverse}",
            "modify": null,
            "$description": "Hover text (dark) → --pgn-color-btn-hover-text-success"
          }
        },
        "border": {
          "success": {
            "$value": "{color.theme.hover.success}",
            "$description": "Hover border (dark) → --pgn-color-btn-hover-border-success"
          }
        }
      },
      "active": {
        "bg": {
          "success": {
            "$value": "{color.theme.active.success}",
            "$description": "Active bg (dark) → --pgn-color-btn-active-bg-success"
          }
        },
        "text": {
          "success": {
            "$value": "{color.text.inverse}",
            "modify": null,
            "$description": "Active text (dark) → --pgn-color-btn-active-text-success"
          }
        },
        "border": {
          "success": {
            "$value": "{color.theme.active.success}",
            "$description": "Active border (dark) → --pgn-color-btn-active-border-success"
          }
        }
      },
      "disabled": {
        "bg": {
          "success": {
            "$value": "{color.btn.bg.success}",
            "$description": "Disabled bg (dark) → --pgn-color-btn-disabled-bg-success"
          }
        },
        "text": {
          "success": {
            "$value": "{color.btn.text.success}",
            "modify": null,
            "$description": "Disabled text (dark) → --pgn-color-btn-disabled-text-success"
          }
        },
        "border": {
          "success": {
            "$value": "{color.btn.border.success}",
            "$description": "Disabled border (dark) → --pgn-color-btn-disabled-border-success"
          }
        }
      },
      "focus": {
        "bg": {
          "success": {
            "$value": "{color.btn.bg.success}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-bg-success",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "border": {
          "success": {
            "$value": "{color.btn.border.success}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-border-success",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "outline": {
          "success": {
            "$value": "{color.theme.focus.success}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-outline-success",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "text": {
          "success": {
            "$value": "{color.btn.text.success}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-text-success",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        }
      }
    }
  }
}
