    "btn": {
      "disabled-link": {
        "$value": "{color.disabled}",
        "$description": "Disabled link button (dark) → --pgn-color-btn-disabled-link"
      }
    }
  },
  "other": {
    "btn": {
      "disabled-opacity": {
