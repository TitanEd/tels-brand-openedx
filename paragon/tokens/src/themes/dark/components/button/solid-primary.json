{
  "$description": "Dark — solid primary. Default / Hover / Active / Disabled. White labels use modify:null.",
  "color": {
    "btn": {
      "bg": {
        "primary": {
          "$value": "{color.primary.base}",
          "$description": "Solid primary bg (dark) → --pgn-color-btn-bg-primary"
        }
      },
      "text": {
        "primary": {
          "$value": "{color.text.inverse}",
          "modify": null,
          "$description": "Solid primary text (dark) → --pgn-color-btn-text-primary"
        }
      },
      "hover": {
        "bg": {
          "primary": {
            "$value": "{color.theme.hover.primary}",
            "$description": "Hover bg (dark) → --pgn-color-btn-hover-bg-primary"
          }
        },
        "text": {
          "primary": {
            "$value": "{color.text.inverse}",
            "modify": null,
            "$description": "Hover text (dark)"
          }
        },
        "border": {
          "primary": {
            "$value": "{color.theme.hover.primary}",
            "$description": "Hover border (dark)"
          }
        }
      },
      "active": {
        "bg": {
          "primary": {
            "$value": "{color.theme.active.primary}",
            "$description": "Active bg (dark)"
          }
        },
        "text": {
          "primary": {
            "$value": "{color.text.inverse}",
            "modify": null,
            "$description": "Active text (dark)"
          }
        },
        "border": {
          "primary": {
            "$value": "{color.theme.active.primary}",
            "$description": "Active border (dark)"
          }
        }
      },
      "disabled": {
        "bg": {
          "primary": {
            "$value": "{color.btn.bg.primary}",
            "$description": "Disabled bg (dark)"
          }
        },
        "text": {
          "primary": {
            "$value": "{color.btn.text.primary}",
            "modify": null,
            "$description": "Disabled text (dark)"
          }
        },
        "border": {
          "primary": {
            "$value": "{color.btn.border.primary}",
            "$description": "Disabled border (dark)"
          }
        }
      },
      "border": {
        "primary": {
          "$value": "{color.btn.bg.primary}",
          "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Solid primary border → --pgn-color-btn-border-primary",
          "$extensions": {
            "tels": {
              "syncedFromLight": true
            }
          }
        }
      },
      "focus": {
        "bg": {
          "primary": {
            "$value": "{color.btn.bg.primary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-bg-primary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "border": {
          "primary": {
            "$value": "{color.btn.border.primary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-border-primary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "outline": {
          "primary": {
            "$value": "{color.theme.focus.primary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-outline-primary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "text": {
          "primary": {
            "$value": "{color.btn.text.primary}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-text-primary",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        }
      }
    }
  }
}
