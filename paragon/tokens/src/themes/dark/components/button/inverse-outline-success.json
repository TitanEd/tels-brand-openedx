{
  "$description": "Dark — inverse outline success: white outline, white fill on hover / press. Labels use modify:null.",
  "color": {
    "btn": {
      "bg": {
        "inverse-outline-success": {
          "$value": "transparent",
          "$description": "bg (dark) → --pgn-color-btn-bg-inverse-outline-success"
        }
      },
      "text": {
        "inverse-outline-success": {
          "$value": "{color.text.inverse}",
          "modify": null,
          "$description": "text (dark) → --pgn-color-btn-text-inverse-outline-success"
        }
      },
      "border": {
