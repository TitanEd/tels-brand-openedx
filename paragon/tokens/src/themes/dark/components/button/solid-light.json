{
  "$description": "Dark — solid light: muted dark surface with light label (modify:null).",
  "color": {
    "btn": {
      "bg": {
        "light": {
          "$value": "{color.light.base}",
          "$description": "bg (dark) → --pgn-color-btn-bg-light"
        }
      },
      "text": {
        "light": {
          "$value": "{color.text.base}",
          "modify": null,
          "$description": "text (dark) → --pgn-color-btn-text-light"
        }
      },
      "border": {
        "light": {
          "$value": "{color.btn.bg.light}",
          "$description": "border (dark) → --pgn-color-btn-border-light"
        }
      },
      "hover": {
        "bg": {
          "light": {
            "$value": "{color.light.600}",
            "$description": "Hover bg (dark) → --pgn-color-btn-hover-bg-light"
          }
        },
        "text": {
          "light": {
            "$value": "{color.text.base}",
            "modify": null,
            "$description": "Hover text (dark) → --pgn-color-btn-hover-text-light"
          }
        },
        "border": {
          "light": {
            "$value": "{color.light.600}",
            "$description": "Hover border (dark) → --pgn-color-btn-hover-border-light"
          }
        }
      },
      "active": {
        "bg": {
          "light": {
            "$value": "{color.light.700}",
            "$description": "Active bg (dark) → --pgn-color-btn-active-bg-light"
          }
        },
        "text": {
          "light": {
            "$value": "{color.text.base}",
            "modify": null,
            "$description": "Active text (dark) → --pgn-color-btn-active-text-light"
          }
        },
        "border": {
          "light": {
            "$value": "{color.light.700}",
            "$description": "Active border (dark) → --pgn-color-btn-active-border-light"
          }
        }
      },
      "disabled": {
        "bg": {
          "light": {
            "$value": "{color.btn.bg.light}",
            "$description": "Disabled bg (dark) → --pgn-color-btn-disabled-bg-light"
          }
        },
        "text": {
          "light": {
            "$value": "{color.btn.text.light}",
            "modify": null,
            "$description": "Disabled text (dark) → --pgn-color-btn-disabled-text-light"
          }
        },
        "border": {
          "light": {
            "$value": "{color.btn.border.light}",
            "$description": "Disabled border (dark) → --pgn-color-btn-disabled-border-light"
          }
        }
      },
      "focus": {
        "bg": {
          "light": {
            "$value": "{color.btn.bg.light}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-bg-light",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "border": {
          "light": {
            "$value": "{color.btn.border.light}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-border-light",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "outline": {
          "light": {
            "$value": "{color.primary.300}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-outline-light",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        },
        "text": {
          "light": {
            "$value": "{color.btn.text.light}",
            "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-color-btn-focus-text-light",
            "$extensions": {
              "tels": {
                "syncedFromLight": true
              }
            }
          }
        }
      }
    }
  }
}
