{
  "$description": "LAYER 2 (dark) — Navbar. On the dark page both navbar variants use white text.",
  "color": {
    "navbar": {
      "dark": {
        "text": {
          "$value": "{color.text.inverse}",
          "modify": [
            {
              "type": "alpha",
              "amount": 0.5
            }
          ],
          "$description": "Navbar text (dark) → --pgn-color-navbar-*-text"
        },
        "hover": {
          "$value": "{color.text.inverse}",
          "modify": [
            {
              "type": "alpha",
              "amount": 0.75
            }
          ],
          "$description": "Navbar hover (dark) → --pgn-color-navbar-*-hover"
        },
        "active": {
          "$value": "{color.text.inverse}",
          "$description": "Navbar active (dark) → --pgn-color-navbar-*-active"
        },
        "disabled": {
          "$value": "{color.text.inverse}",
          "modify": [
            {
              "type": "alpha",
              "amount": 0.25
            }
          ],
          "$description": "Navbar disabled (dark) → --pgn-color-navbar-*-disabled"
        }
      },
      "light": {
        "text": {
          "$value": "{color.text.inverse}",
          "modify": [
            {
              "type": "alpha",
              "amount": 0.6
            }
          ],
          "$description": "Navbar text (dark) → --pgn-color-navbar-*-text"
        },
        "hover": {
          "$value": "{color.text.inverse}",
          "modify": [
            {
              "type": "alpha",
              "amount": 0.8
            }
          ],
          "$description": "Navbar hover (dark) → --pgn-color-navbar-*-hover"
        },
        "active": {
          "$value": "{color.text.inverse}",
          "modify": [
            {
              "type": "alpha",
              "amount": 0.95
            }
          ],
          "$description": "Navbar active (dark) → --pgn-color-navbar-*-active"
        },
        "disabled": {
          "$value": "{color.text.inverse}",
          "modify": [
            {
              "type": "alpha",
              "amount": 0.3
            }
          ],
          "$description": "Navbar disabled (dark) → --pgn-color-navbar-*-disabled"
        }
      }
    }
  }
}
