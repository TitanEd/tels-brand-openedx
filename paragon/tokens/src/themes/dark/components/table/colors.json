{
  "$description": "LAYER 2 (dark) — Table / DataTable.",
  "color": {
    "table": {
      "border": {
        "$value": "{color.border}",
        "$description": "Table border (dark) → --pgn-color-table-border"
      },
      "caption": {
        "$value": "{color.text.muted}",
        "$description": "Table caption (dark) → --pgn-color-table-caption"
      }
    },
    "data-table": {
      "bg": {
        "base": {
          "$value": "{color.surface.base}",
          "$description": "DataTable background (dark) → --pgn-color-data-table-bg-base"
        }
      },
      "border": {
        "$value": "{color.light.300}",
        "$description": "DataTable border (dark) → --pgn-color-data-table-border"
      },
      "text": {
        "$value": "{color.body.base}",
        "$description": "DataTable text (dark) → --pgn-color-data-table-text"
      },
      "header": {
        "bg": {
          "$value": "{color.light.300}",
          "$description": "DataTable header background (dark) → --pgn-color-data-table-header-bg"
        },
        "text": {
          "$value": "{color.body.base}",
          "$description": "DataTable header text (dark) → --pgn-color-data-table-header-text"
        }
      },
      "row": {
        "striped": {
          "bg": {
            "$value": "{color.light.200}",
            "$description": "Striped row (dark) → --pgn-color-data-table-row-striped-bg"
          }
        },
        "selected": {
          "bg": {
            "$value": "{color.info.base}",
            "modify": [
              {
                "type": "mix",
                "otherColor": "#111827",
                "amount": "0.75"
              }
            ],
            "$description": "Selected row (dark): info mixed 75% into the page color → --pgn-color-data-table-row-selected-bg"
          }
        }
      }
    }
  },
  "elevation": {
    "data-table": {
      "box-shadow": {
        "$value": "{elevation.box-shadow.sm}",
        "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-elevation-data-table-box-shadow",
        "$extensions": {
          "tels": {
            "syncedFromLight": true
          }
        }
      }
    }
  }
}
