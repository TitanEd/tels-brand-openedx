{
  "$description": "LAYER 2 (dark) — Card.",
  "color": {
    "card": {
      "base": {
        "$value": "inherit",
        "$description": "Card text (dark) → --pgn-color-card-base"
      },
      "bg": {
        "base": {
          "$value": "{color.surface.base}",
          "$description": "Card background (dark) → --pgn-color-card-bg-base"
        },
        "dark": {
          "$value": "{color.primary.base}",
          "$description": "Dark card variant (dark) → --pgn-color-card-bg-dark"
        },
        "muted": {
          "$value": "{color.light.200}",
          "$description": "Muted card (dark) → --pgn-color-card-bg-muted"
        }
      },
      "border": {
        "base": {
          "$value": "{color.text.inverse}",
          "modify": [
            {
              "type": "alpha",
              "amount": 0.125
            }
          ],
          "$description": "Card border (dark): white at 12.5% → --pgn-color-card-border-base"
        },
        "focus": {
          "base": {
            "$value": "{color.primary.base}",
            "$description": "Card focus ring (dark) → --pgn-color-card-border-focus-base"
          },
          "dark": {
            "$value": "{color.theme.focus.primary}",
            "$description": "Dark card focus ring (dark) → --pgn-color-card-border-focus-dark"
          }
        }
      },
      "divider-bg": {
        "$value": "{color.light.400}",
        "$description": "Card divider (dark) → --pgn-color-card-divider-bg"
      },
      "header-title": {
        "$value": "{color.headings.base}",
        "$description": "TitanEd: Card.Header title (dark) → --pgn-color-card-header-title"
      },
      "status-text": {
        "$value": "{color.text.base}",
        "$description": "TitanEd: Card.Status message (dark); the success/danger/warning tints stay pale in dark → --pgn-color-card-status-text"
      }
    }
  }
}
