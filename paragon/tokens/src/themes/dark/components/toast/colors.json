    "toast": {
      "base": {
        "$value": "inherit",
        "$description": "Toast text (dark) \u2192 --pgn-color-toast-base"
      },
      "bg": {
        "$value": "{color.gray.100}",
        "$description": "Toast background (dark) \u2192 --pgn-color-toast-bg"
      },
      "border": {
        "$value": "{color.white}",
        "modify": [
          {
            "type": "alpha",
            "amount": 0.1
          }
