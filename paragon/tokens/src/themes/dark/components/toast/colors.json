{
  "$description": "LAYER 2 (dark) — Toast. One step lighter than the page so it stands out.",
  "color": {
    "toast": {
      "base": {
        "$value": "inherit",
        "$description": "Toast text (dark) → --pgn-color-toast-base"
      },
      "bg": {
        "$value": "{color.gray.100}",
        "$description": "Toast background (dark) → --pgn-color-toast-bg"
      },
      "border": {
        "$value": "{color.text.inverse}",
        "modify": [
          {
            "type": "alpha",
            "amount": 0.1
          }
        ],
        "$description": "Toast border (dark): white at 10% → --pgn-color-toast-border"
      },
      "header": {
        "text": {
          "$value": "{color.text.inverse}",
          "$description": "Toast header text (dark) → --pgn-color-toast-header-text"
        },
        "bg": {
          "$value": "{color.gray.200}",
          "$description": "Toast header background (dark) → --pgn-color-toast-header-bg"
        },
        "border": {
          "$value": "{color.text.inverse}",
          "modify": [
            {
              "type": "alpha",
              "amount": 0.15
            }
          ],
          "$description": "Toast header border (dark): white at 15% → --pgn-color-toast-header-border"
        }
      }
    }
  },
  "elevation": {
    "toast": {
      "box-shadow": {
        "$value": [
          {
            "color": "rgba(0, 0, 0, .15)",
            "offsetX": "0",
            "offsetY": "1.25rem",
            "blur": "2.5rem"
          },
          {
            "color": "rgba(0, 0, 0, .15)",
            "offsetX": "0",
            "offsetY": ".5rem",
            "blur": "3rem"
          }
        ],
        "$description": "Dark twin of the light token (scripts/sync-dark-tokens.js). Paragon default → --pgn-elevation-toast-box-shadow",
        "$extensions": {
          "tels": {
            "syncedFromLight": true
          }
        }
      }
    }
  }
}
