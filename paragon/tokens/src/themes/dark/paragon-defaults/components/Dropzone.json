{
  "$description": "Dark twin of Paragon's themes/light/components/Dropzone.json (scripts/sync-dark-tokens.js).",
  "color": {
    "dropzone": {
      "error-wrapper": {
        "source": "$dropzone-error-wrapper-color",
        "$value": "{color.danger.500}",
        "$description": "Paragon default → --pgn-color-dropzone-error-wrapper (dark twin of Paragon's light token; scripts/sync-dark-tokens.js).",
        "$extensions": {
          "tels": {
            "syncedFromLight": true
          }
        }
      }
    }
  },
  "elevation": {
    "dropzone": {
      "active": {
        "source": "$dropzone-box-shadow-active",
        "$value": {
          "color": "{color.primary.500}",
          "spread": "2px",
          "offsetX": "0",
          "offsetY": "0",
          "blur": "0",
          "inset": "inset"
        },
        "$description": "Paragon default → --pgn-elevation-dropzone-active (dark twin of Paragon's light token; scripts/sync-dark-tokens.js).",
        "$extensions": {
          "tels": {
            "syncedFromLight": true
          }
        }
      },
      "error": {
        "source": "$dropzone-box-shadow-error",
        "$value": {
          "color": "{color.danger.300}",
          "spread": "2px",
          "offsetX": "0",
          "offsetY": "0",
          "blur": "0",
          "inset": "inset"
        },
        "$description": "Paragon default → --pgn-elevation-dropzone-error (dark twin of Paragon's light token; scripts/sync-dark-tokens.js).",
        "$extensions": {
          "tels": {
            "syncedFromLight": true
          }
        }
      }
    }
  }
}
