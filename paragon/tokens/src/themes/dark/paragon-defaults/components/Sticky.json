{
  "$description": "Dark twin of Paragon's themes/light/components/Sticky.json (scripts/sync-dark-tokens.js).",
  "elevation": {
    "sticky": {
      "shadow": {
        "top": {
          "source": "$sticky-shadow-top",
          "$value": [
            {
              "color": "rgba(0, 0, 0, .15)",
              "offsetX": "0",
              "offsetY": "-.5rem",
              "blur": "1rem"
            },
            {
              "color": "rgba(0, 0, 0, .15)",
              "offsetX": "0",
              "offsetY": "-.25rem",
              "blur": ".625rem"
            }
          ],
          "$description": "Paragon default → --pgn-elevation-sticky-shadow-top (dark twin of Paragon's light token; scripts/sync-dark-tokens.js).",
          "$extensions": {
            "tels": {
              "syncedFromLight": true
            }
          }
        },
        "bottom": {
          "source": "$sticky-shadow-bottom",
          "$value": [
            {
              "color": "rgba(0, 0, 0, .15)",
              "offsetX": "0",
              "offsetY": ".5rem",
              "blur": "1rem"
            },
            {
              "color": "rgba(0, 0, 0, .15)",
              "offsetX": "0",
              "offsetY": ".25rem",
              "blur": ".625rem"
            }
          ],
          "$description": "Paragon default → --pgn-elevation-sticky-shadow-bottom (dark twin of Paragon's light token; scripts/sync-dark-tokens.js).",
          "$extensions": {
            "tels": {
              "syncedFromLight": true
            }
          }
        }
      }
    }
  }
}
