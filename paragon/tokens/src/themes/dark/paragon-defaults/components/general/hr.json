{
  "$description": "Dark twin of Paragon's themes/light/components/general/hr.json (scripts/sync-dark-tokens.js).",
  "color": {
    "hr": {
      "border": {
        "source": "$hr-border-color",
        "modify": [
          {
            "type": "alpha",
            "amount": 0.1
          }
        ],
        "$value": "{color.black}",
        "$description": "Paragon default → --pgn-color-hr-border (dark twin of Paragon's light token; scripts/sync-dark-tokens.js).",
        "$extensions": {
          "tels": {
            "syncedFromLight": true
          }
        }
      }
    }
  }
}
