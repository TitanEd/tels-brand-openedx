{
  "$description": "dropzone — Paragon defaults (copied from @openedx/paragon tokens; values unchanged). Edit here to change them for TitanEd.",
  "color": {
    "$type": "color",
    "dropzone": {
      "border": {
        "base": {
          "$value": "{color.gray.500}",
          "$description": "Paragon default → --pgn-color-dropzone-border-base"
        }
      },
      "restriction-msg": {
        "$value": "{color.gray.500}",
        "$description": "Paragon default → --pgn-color-dropzone-restriction-msg"
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "dropzone": {
      "focus": {
        "$value": {
          "color": "{color.primary.500}",
          "spread": "2px",
          "offsetX": "0",
          "offsetY": "0",
          "blur": "0",
          "inset": "inset"
        },
        "$description": "Theme primary colour (Paragon's info-300 blue ignored the theme) → --pgn-elevation-dropzone-focus"
      },
      "hover": {
        "$value": {
          "color": "{color.primary.500}",
          "spread": "2px",
          "offsetX": "0",
          "offsetY": "0",
          "blur": "0",
          "inset": "inset"
        },
        "$description": "Theme primary colour (Paragon's info-300 blue ignored the theme) → --pgn-elevation-dropzone-hover"
      }
    }
  }
}
