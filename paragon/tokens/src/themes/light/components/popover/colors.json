{
  "$description": "popover — Paragon defaults (copied from @openedx/paragon tokens; values unchanged). Edit here to change them for TitanEd.",
  "color": {
    "$type": "color",
    "popover": {
      "arrow": {
        "base": {
          "$value": "{color.popover.bg}",
          "$description": "Paragon default → --pgn-color-popover-arrow-base"
        },
        "outer": {
          "modify": [
            {
              "type": "alpha",
              "amount": 0.05
            }
          ],
          "$value": "{color.popover.border}",
          "$description": "Paragon default → --pgn-color-popover-arrow-outer"
        }
      },
      "bg": {
        "$value": "{color.bg.base}",
        "$description": "Paragon default → --pgn-color-popover-bg"
      },
      "body": {
        "$value": "{color.body.base}",
        "$description": "Paragon default → --pgn-color-popover-body"
      },
      "border": {
        "$value": "rgba(0, 0, 0, .2)",
        "$description": "Paragon default → --pgn-color-popover-border"
      },
      "header": {
        "bg": {
          "$value": "{color.white}",
          "$description": "Paragon default → --pgn-color-popover-header-bg"
        },
        "border-bottom-dark": {
          "modify": [
            {
              "type": "darken",
              "amount": 0.05
            }
          ],
          "$value": "{color.white}",
          "$description": "Paragon default → --pgn-color-popover-header-border-bottom-dark"
        },
        "text": {
          "$value": "{color.headings.base}",
          "$description": "Paragon default → --pgn-color-popover-header-text"
        }
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "popover": {
      "box-shadow": {
        "$value": "none",
        "$description": "Paragon default → --pgn-elevation-popover-box-shadow"
      }
    }
  }
}
