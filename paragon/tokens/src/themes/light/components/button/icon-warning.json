{
  "$description": "button — Paragon defaults (copied from @openedx/paragon tokens; values unchanged). Edit here to change them for TitanEd.",
  "color": {
    "$type": "color",
    "icon-button": {
      "bg": {
        "warning": {
          "base": {
            "$value": "{color.icon-button.bg.base}",
            "$description": "Paragon default → --pgn-color-icon-button-bg-warning-base"
          },
          "focus": {
            "$value": "{color.icon-button.bg.base}",
            "$description": "Paragon default → --pgn-color-icon-button-bg-warning-focus"
          },
          "hover": {
            "$value": "{color.warning.base}",
            "$description": "Paragon default → --pgn-color-icon-button-bg-warning-hover"
          }
        }
      },
      "text": {
        "warning": {
          "base": {
            "$value": "{color.warning.base}",
            "$description": "Paragon default → --pgn-color-icon-button-text-warning-base"
          },
          "focus": {
            "$value": "{color.icon-button.text.warning.base}",
            "$description": "Paragon default → --pgn-color-icon-button-text-warning-focus"
          },
          "hover": {
            "$value": "{color.icon-button.accent}",
            "$description": "Paragon default → --pgn-color-icon-button-text-warning-hover"
          }
        }
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "icon-button": {
      "box-shadow": {
        "warning": {
          "base": {
            "$value": {
              "color": "{color.icon-button.text.warning.base}",
              "spread": "{size.btn.focus.width}",
              "offsetX": "0",
              "offsetY": "0",
              "blur": "0",
              "inset": "inset"
            },
            "$description": "Paragon default → --pgn-elevation-icon-button-box-shadow-warning-base"
          }
        }
      }
    }
  }
}
