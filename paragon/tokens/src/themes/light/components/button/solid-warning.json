{
  "$description": "SOLID WARNING \u2014 class: .btn.btn-warning.",
  "color": {
    "btn": {
      "bg": {
        "warning": {
          "$value": "{color.warning.base}",
          "$description": "Solid warning bg \u2192 --pgn-color-btn-bg-warning"
        }
      },
      "text": {
        "warning": {
          "$value": "{color.btn.bg.warning}",
          "$description": "Solid warning text \u2192 --pgn-color-btn-text-warning",
          "modify": [
            {
              "type": "color-yiq"
            }
          ]
        }
      },
      "border": {
        "warning": {
          "$value": "{color.btn.bg.warning}",
          "$description": "Solid warning border \u2192 --pgn-color-btn-border-warning"
        }
      },
      "hover": {
        "bg": {
          "warning": {
            "$value": "{color.theme.hover.warning}",
            "$description": "Hover bg \u2192 --pgn-color-btn-hover-bg-warning"
          }
        },
        "text": {
          "warning": {
            "$value": "{color.btn.bg.warning}",
            "$description": "Hover text \u2192 --pgn-color-btn-hover-text-warning",
            "modify": [
              {
                "type": "color-yiq"
              }
            ]
          }
