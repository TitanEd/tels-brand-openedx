{
  "$description": "OUTLINE SECONDARY — class: btn btn-outline-secondary (Gradebook Apply, pagination-adjacent actions)",
  "color": {
    "btn": {
      "bg": {
        "outline-secondary": {
          "$value": "transparent",
          "$description": "Background → --pgn-color-btn-bg-outline-secondary"
        }
      },
      "text": {
        "outline-secondary": {
          "$value": "{color.secondary.base}",
          "$description": "Text → --pgn-color-btn-text-outline-secondary"
        }
      },
      "border": {
        "outline-secondary": {
          "$value": "{color.secondary.base}",
          "$description": "Border → --pgn-color-btn-border-outline-secondary"
        }
      },
      "hover": {
        "bg": {
          "outline-secondary": {
            "$value": "{color.secondary.100}",
            "$description": "Hover bg"
          }
        },
        "text": {
          "outline-secondary": {
            "$value": "{color.theme.hover.secondary}",
            "$description": "Hover text"
          }
        },
        "border": {
          "outline-secondary": {
            "$value": "{color.theme.hover.secondary}",
            "$description": "Hover border"
          }
        }
      },
      "active": {
        "bg": {
          "outline-secondary": {
            "$value": "transparent",
            "$description": "Active bg → --pgn-color-btn-active-bg-outline-secondary"
          }
        },
        "text": {
          "outline-secondary": {
            "$value": "{color.theme.active.secondary}",
            "modify": null,
            "$description": "Active text → --pgn-color-btn-active-text-outline-secondary"
          }
        },
        "border": {
          "outline-secondary": {
            "$value": "{color.theme.active.secondary}",
            "$description": "Active border → --pgn-color-btn-active-border-outline-secondary"
          }
        }
      },
      "disabled": {
        "bg": {
          "outline-secondary": {
            "$value": "transparent",
            "$description": "Disabled bg → --pgn-color-btn-disabled-bg-outline-secondary"
          }
        },
        "text": {
          "outline-secondary": {
            "$value": "{color.btn.text.outline-secondary}",
            "$description": "Disabled text → --pgn-color-btn-disabled-text-outline-secondary"
          }
        },
        "border": {
          "outline-secondary": {
            "$value": "{color.btn.border.outline-secondary}",
            "$description": "Disabled border → --pgn-color-btn-disabled-border-outline-secondary"
          }
        }
      },
      "focus": {
        "bg": {
          "outline-secondary": {
            "$value": "transparent",
            "$description": "Paragon default → --pgn-color-btn-focus-bg-outline-secondary"
          }
        },
        "border": {
          "outline-secondary": {
            "$value": "{color.btn.border.outline-secondary}",
            "$description": "Paragon default → --pgn-color-btn-focus-border-outline-secondary"
          }
        },
        "outline": {
          "outline-secondary": {
            "$value": "{color.theme.focus.secondary}",
            "$description": "Paragon default → --pgn-color-btn-focus-outline-outline-secondary"
          }
        },
        "text": {
          "outline-secondary": {
            "$value": "{color.btn.text.outline-secondary}",
            "$description": "Paragon default → --pgn-color-btn-focus-text-outline-secondary"
          }
        }
      }
    }
  }
}
