{
  "$description": "Layer 2 — Button solid brand. Hover/active: Paragon defaults — do not override here.",
  "color": {
    "btn": {
      "bg": {
        "brand": {
          "$value": "{color.brand.base}",
          "$description": "UI label: Solid brand background → --pgn-color-btn-bg-brand"
        }
      },
      "text": {
        "brand": {
          "$value": "#FFFFFF",
          "modify": null,
          "$description": "UI label: Solid brand text → --pgn-color-btn-text-brand"
        },
        "outline-brand": {
          "$value": "{color.brand.base}",
          "$description": "Outline brand text"
        }
      },
      "border": {
        "brand": {
          "$value": "{color.btn.bg.brand}",
          "$description": "Solid brand border"
        },
        "outline-brand": {
          "$value": "{color.brand.base}",
          "$description": "Outline brand border"
        }
      }
    }
  }
}
