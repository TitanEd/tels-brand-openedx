      "text": {
        "secondary": {
          "base": {
            "$value": "{color.secondary.base}",
            "$description": "Icon color → --pgn-color-icon-button-text-secondary-base"
          }
        }
      },
      "bg": {
        "secondary": {
          "hover": {
            "$value": "{color.secondary.base}",
