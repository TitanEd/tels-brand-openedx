{
  "$description": "ICON BUTTON PRIMARY — class: btn-icon btn-icon-primary (+ btn-icon-primary-active). Does NOT change solid btn-primary. On primary fill (hover/active), icon must be white.",
  "color": {
    "icon-button": {
      "text": {
        "primary": {
          "base": {
            "$value": "{color.primary.base}",
            "$description": "Default icon (transparent bg) → --pgn-color-icon-button-text-primary-base"
          },
          "hover": {
            "$value": "#FFFFFF",
            "modify": null,
            "$description": "Icon on primary hover fill → --pgn-color-icon-button-text-primary-hover"
          },
          "active": {
            "base": {
              "$value": "#FFFFFF",
              "modify": null,
              "$description": "Icon on primary active fill (.btn-icon-primary-active) → --pgn-color-icon-button-text-primary-active-base"
            },
            "hover": {
              "$value": "#FFFFFF",
              "modify": null,
              "$description": "Active+hover icon → --pgn-color-icon-button-text-primary-active-hover"
            },
            "focus": {
              "$value": "#FFFFFF",
              "modify": null,
              "$description": "Active+focus icon → --pgn-color-icon-button-text-primary-active-focus"
            }
          },
          "focus": {
            "$value": "{color.icon-button.text.primary.base}",
            "$description": "Paragon default → --pgn-color-icon-button-text-primary-focus"
          },
          "inverse": {
            "base": {
              "$value": "{color.icon-button.accent}",
              "$description": "Paragon default → --pgn-color-icon-button-text-primary-inverse-base"
            },
            "focus": {
              "$value": "{color.icon-button.accent}",
              "$description": "Paragon default → --pgn-color-icon-button-text-primary-inverse-focus"
            },
            "hover": {
              "$value": "{color.icon-button.text.primary.base}",
              "$description": "Paragon default → --pgn-color-icon-button-text-primary-inverse-hover"
            }
          }
        }
      },
      "bg": {
        "primary": {
          "hover": {
            "$value": "{color.primary.base}",
            "$description": "Hover background for icon-primary"
          },
          "active": {
            "base": {
              "$value": "{color.primary.base}",
              "$description": "Active background (.btn-icon-primary-active)"
            },
            "focus": {
              "$value": "{color.icon-button.text.primary.base}",
              "$description": "Paragon default → --pgn-color-icon-button-bg-primary-active-focus"
            },
            "hover": {
              "$value": "{color.icon-button.text.primary.base}",
              "$description": "Paragon default → --pgn-color-icon-button-bg-primary-active-hover"
            }
          },
          "base": {
            "$value": "{color.icon-button.bg.base}",
            "$description": "Paragon default → --pgn-color-icon-button-bg-primary-base"
          },
          "focus": {
            "$value": "{color.icon-button.bg.base}",
            "$description": "Paragon default → --pgn-color-icon-button-bg-primary-focus"
          },
          "inverse": {
            "base": {
              "$value": "{color.icon-button.bg.base}",
              "$description": "Paragon default → --pgn-color-icon-button-bg-primary-inverse-base"
            },
            "focus": {
              "$value": "{color.icon-button.bg.base}",
              "$description": "Paragon default → --pgn-color-icon-button-bg-primary-inverse-focus"
            },
            "hover": {
              "$value": "{color.icon-button.accent}",
              "$description": "Paragon default → --pgn-color-icon-button-bg-primary-inverse-hover"
            }
          }
        }
      },
      "accent": {
        "$value": "{color.white}",
        "$description": "Paragon default → --pgn-color-icon-button-accent"
      }
    }
  },
  "elevation": {
    "icon-button": {
      "box-shadow": {
        "primary": {
          "active": {
            "$value": "none",
            "$description": "Paragon default → --pgn-elevation-icon-button-box-shadow-primary-active"
          },
          "base": {
            "$value": {
              "color": "{color.icon-button.text.primary.base}",
              "spread": "{size.btn.focus.width}",
              "offsetX": "0",
              "offsetY": "0",
              "blur": "0",
              "inset": "inset"
            },
            "$description": "Paragon default → --pgn-elevation-icon-button-box-shadow-primary-base"
          },
          "inverse": {
            "$value": {
              "color": "{color.icon-button.accent}",
              "spread": "{size.btn.focus.width}",
              "offsetX": "0",
              "offsetY": "0",
              "blur": "0",
              "inset": "inset"
            },
            "$description": "Paragon default → --pgn-elevation-icon-button-box-shadow-primary-inverse"
          }
        }
      }
    }
  }
}
