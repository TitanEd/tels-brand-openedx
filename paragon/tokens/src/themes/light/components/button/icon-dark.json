{
  "$description": "button — Paragon defaults (copied from @openedx/paragon tokens; values unchanged). Edit here to change them for TitanEd.",
  "color": {
    "$type": "color",
    "icon-button": {
      "bg": {
        "dark": {
          "base": {
            "$value": "{color.icon-button.bg.base}",
            "$description": "Paragon default → --pgn-color-icon-button-bg-dark-base"
          },
          "focus": {
            "$value": "{color.icon-button.bg.base}",
            "$description": "Paragon default → --pgn-color-icon-button-bg-dark-focus"
          },
          "hover": {
            "$value": "{color.dark.base}",
            "$description": "Paragon default → --pgn-color-icon-button-bg-dark-hover"
          },
          "inverse": {
            "base": {
              "$value": "{color.icon-button.bg.base}",
              "$description": "Paragon default → --pgn-color-icon-button-bg-dark-inverse-base"
            },
            "focus": {
              "$value": "{color.icon-button.bg.base}",
              "$description": "Paragon default → --pgn-color-icon-button-bg-dark-inverse-focus"
            },
            "hover": {
              "$value": "{color.icon-button.accent}",
              "$description": "Paragon default → --pgn-color-icon-button-bg-dark-inverse-hover"
            }
          }
        }
      },
      "text": {
        "dark": {
          "base": {
            "$value": "{color.dark.base}",
            "$description": "Paragon default → --pgn-color-icon-button-text-dark-base"
          },
          "focus": {
            "$value": "{color.icon-button.text.dark.base}",
            "$description": "Paragon default → --pgn-color-icon-button-text-dark-focus"
          },
          "hover": {
            "$value": "{color.icon-button.accent}",
            "$description": "Paragon default → --pgn-color-icon-button-text-dark-hover"
          },
          "inverse": {
            "base": {
              "$value": "{color.icon-button.accent}",
              "$description": "Paragon default → --pgn-color-icon-button-text-dark-inverse-base"
            },
            "focus": {
              "$value": "{color.icon-button.accent}",
              "$description": "Paragon default → --pgn-color-icon-button-text-dark-inverse-focus"
            },
            "hover": {
              "$value": "{color.dark.base}",
              "$description": "Paragon default → --pgn-color-icon-button-text-dark-inverse-hover"
            }
          }
        }
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "icon-button": {
      "box-shadow": {
        "dark": {
          "base": {
            "$value": {
              "color": "{color.icon-button.text.dark.base}",
              "spread": "{size.btn.focus.width}",
              "offsetX": "0",
              "offsetY": "0",
              "blur": "0",
              "inset": "inset"
            },
            "$description": "Paragon default → --pgn-elevation-icon-button-box-shadow-dark-base"
          },
          "inverse": {
            "$value": {
              "color": "{color.icon-button.accent}",
              "spread": "{size.btn.focus.width}",
              "offsetX": "0",
              "offsetY": "0",
              "blur": "0",
              "inset": "inset"
            },
            "$description": "Paragon default → --pgn-elevation-icon-button-box-shadow-dark-inverse"
          }
        }
      }
    }
  }
}
