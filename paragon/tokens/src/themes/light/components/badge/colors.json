{
  "$description": "BADGE (light) — component-level color tokens (class: .badge). bg per variant links to our semantic roots (primary/secondary/success/warning/danger/info/light/dark), so changing those at Layer 1 still cascades here; each is also independently overridable.",
  "color": {
    "badge": {
      "bg": {
        "primary": { "$value": "{color.primary.base}", "$description": "Primary badge bg → --pgn-color-badge-bg-primary" },
        "secondary": { "$value": "{color.secondary.base}", "$description": "Secondary badge bg → --pgn-color-badge-bg-secondary" },
        "success": { "$value": "{color.success.base}", "$description": "Success badge bg → --pgn-color-badge-bg-success" },
        "warning": { "$value": "{color.warning.base}", "$description": "Warning badge bg → --pgn-color-badge-bg-warning" },
        "danger": { "$value": "{color.danger.base}", "$description": "Danger badge bg → --pgn-color-badge-bg-danger" },
        "info": { "$value": "{color.info.base}", "$description": "Info badge bg → --pgn-color-badge-bg-info" },
        "light": { "$value": "{color.light.base}", "$description": "Light badge bg → --pgn-color-badge-bg-light" },
        "dark": { "$value": "{color.dark.base}", "$description": "Dark badge bg → --pgn-color-badge-bg-dark" }
      },
      "text": {
        "primary": { "$value": "{color.primary.base}", "modify": [{ "type": "color-yiq" }], "$description": "Primary badge text (auto light/dark contrast) → --pgn-color-badge-text-primary" },
        "secondary": { "$value": "{color.secondary.base}", "modify": [{ "type": "color-yiq" }], "$description": "Secondary badge text → --pgn-color-badge-text-secondary" },
        "success": { "$value": "{color.success.base}", "modify": [{ "type": "color-yiq" }], "$description": "Success badge text → --pgn-color-badge-text-success" },
        "warning": { "$value": "{color.warning.base}", "modify": [{ "type": "color-yiq" }], "$description": "Warning badge text → --pgn-color-badge-text-warning" },
        "danger": { "$value": "{color.danger.base}", "modify": [{ "type": "color-yiq" }], "$description": "Danger badge text → --pgn-color-badge-text-danger" },
        "info": { "$value": "{color.info.base}", "modify": [{ "type": "color-yiq" }], "$description": "Info badge text → --pgn-color-badge-text-info" },
        "light": { "$value": "{color.light.base}", "modify": [{ "type": "color-yiq" }], "$description": "Light badge text → --pgn-color-badge-text-light" },
        "dark": { "$value": "{color.dark.base}", "modify": [{ "type": "color-yiq" }], "$description": "Dark badge text → --pgn-color-badge-text-dark" }
      },
      "focus": {
        "bg": {
          "danger": { "modify": [{ "type": "darken", "amount": 0.1 }], "$value": "{color.badge.bg.danger}", "$description": "Paragon default → --pgn-color-badge-focus-bg-danger" },
          "dark": { "modify": [{ "type": "darken", "amount": 0.1 }], "$value": "{color.badge.bg.dark}", "$description": "Paragon default → --pgn-color-badge-focus-bg-dark" },
          "info": { "modify": [{ "type": "darken", "amount": 0.1 }], "$value": "{color.badge.bg.info}", "$description": "Paragon default → --pgn-color-badge-focus-bg-info" },
          "light": { "modify": [{ "type": "darken", "amount": 0.1 }], "$value": "{color.badge.bg.light}", "$description": "Paragon default → --pgn-color-badge-focus-bg-light" },
          "primary": { "modify": [{ "type": "darken", "amount": 0.1 }], "$value": "{color.badge.bg.primary}", "$description": "Paragon default → --pgn-color-badge-focus-bg-primary" },
          "secondary": { "modify": [{ "type": "darken", "amount": 0.1 }], "$value": "{color.badge.bg.secondary}", "$description": "Paragon default → --pgn-color-badge-focus-bg-secondary" },
          "success": { "modify": [{ "type": "darken", "amount": 0.1 }], "$value": "{color.badge.bg.success}", "$description": "Paragon default → --pgn-color-badge-focus-bg-success" },
          "warning": { "modify": [{ "type": "darken", "amount": 0.1 }], "$value": "{color.badge.bg.warning}", "$description": "Paragon default → --pgn-color-badge-focus-bg-warning" }
        },
        "box-shadow": {
          "danger": { "modify": [{ "type": "alpha", "amount": 0.05 }], "$value": "{color.badge.bg.danger}", "$description": "Paragon default → --pgn-color-badge-focus-box-shadow-danger" },
          "dark": { "modify": [{ "type": "alpha", "amount": 0.05 }], "$value": "{color.badge.bg.dark}", "$description": "Paragon default → --pgn-color-badge-focus-box-shadow-dark" },
          "info": { "modify": [{ "type": "alpha", "amount": 0.05 }], "$value": "{color.badge.bg.info}", "$description": "Paragon default → --pgn-color-badge-focus-box-shadow-info" },
          "light": { "modify": [{ "type": "alpha", "amount": 0.05 }], "$value": "{color.badge.bg.light}", "$description": "Paragon default → --pgn-color-badge-focus-box-shadow-light" },
          "primary": { "modify": [{ "type": "alpha", "amount": 0.05 }], "$value": "{color.badge.bg.primary}", "$description": "Paragon default → --pgn-color-badge-focus-box-shadow-primary" },
          "secondary": { "modify": [{ "type": "alpha", "amount": 0.05 }], "$value": "{color.badge.bg.secondary}", "$description": "Paragon default → --pgn-color-badge-focus-box-shadow-secondary" },
          "success": { "modify": [{ "type": "alpha", "amount": 0.05 }], "$value": "{color.badge.bg.success}", "$description": "Paragon default → --pgn-color-badge-focus-box-shadow-success" },
          "warning": { "modify": [{ "type": "alpha", "amount": 0.05 }], "$value": "{color.badge.bg.warning}", "$description": "Paragon default → --pgn-color-badge-focus-box-shadow-warning" }
        },
        "danger": { "$value": "{color.badge.text.danger}", "$description": "Paragon default → --pgn-color-badge-focus-danger" },
        "dark": { "$value": "{color.badge.text.dark}", "$description": "Paragon default → --pgn-color-badge-focus-dark" },
        "info": { "$value": "{color.badge.text.info}", "$description": "Paragon default → --pgn-color-badge-focus-info" },
        "light": { "$value": "{color.badge.text.light}", "$description": "Paragon default → --pgn-color-badge-focus-light" },
        "primary": { "$value": "{color.badge.text.primary}", "$description": "Paragon default → --pgn-color-badge-focus-primary" },
        "secondary": { "$value": "{color.badge.text.secondary}", "$description": "Paragon default → --pgn-color-badge-focus-secondary" },
        "success": { "$value": "{color.badge.text.success}", "$description": "Paragon default → --pgn-color-badge-focus-success" },
        "warning": { "$value": "{color.badge.text.warning}", "$description": "Paragon default → --pgn-color-badge-focus-warning" }
      }
    }
  }
}
