  "color": {
    "$type": "color",
    "product-tour": {
      "checkpoint": {
        "bg": {
          "$value": "{color.light.300}",
          "$description": "Paragon default → --pgn-color-product-tour-checkpoint-bg"
        },
        "body": {
          "$value": "{color.gray.700}",
          "$description": "Paragon default → --pgn-color-product-tour-checkpoint-body"
        },
        "border": {
          "$value": "{color.brand.base}",
          "$description": "Paragon default → --pgn-color-product-tour-checkpoint-border"
        },
        "breadcrumb": {
          "$value": "{color.primary.base}",
          "$description": "Paragon default → --pgn-color-product-tour-checkpoint-breadcrumb"
        },
        "box-shadow": {
          "modify": [
            {
              "type": "alpha",
              "amount": 0.3
            }
          ],
          "$value": "{color.black}",
          "$description": "Paragon default → --pgn-color-product-tour-checkpoint-box-shadow"
        },
        "arrow": {
          "border": {
            "top": {
              "$value": "{color.product-tour.checkpoint.bg}",
              "$description": "Paragon default → --pgn-color-product-tour-checkpoint-arrow-border-top"
            },
            "transparent": {
              "$value": "transparent",
              "$description": "Paragon default → --pgn-color-product-tour-checkpoint-arrow-border-transparent"
            }
          }
        }
      }
    }
