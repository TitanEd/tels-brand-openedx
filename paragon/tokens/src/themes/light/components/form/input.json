{
  "$description": "LAYER 2 — Form colors (.form-control, select, checkbox). Applied by overrides/_forms.scss + _selects.scss. Paragon checkbox: keep indicator bg white + SVG check token on :checked — do NOT paint checked fill primary (hides mark).",
  "color": {
    "form": {
      "input": {
        "base": {
          "$value": "{color.gray.700}",
          "$description": "Input/select text → --pgn-color-form-input-base"
        },
        "border": {
          "$value": "{color.gray.500}",
          "$description": "Input/select border → --pgn-color-form-input-border"
        },
        "bg": {
          "base": {
            "$value": "{color.bg.base}",
            "$description": "Input/select background → --pgn-color-form-input-bg-base"
          },
          "disabled": {
            "$value": "{color.gray.100}",
            "$description": "Disabled background"
          }
        },
        "focus": {
          "border": {
            "$value": "{color.primary.base}",
            "$description": "Focus border → --pgn-color-form-input-focus-border"
          },
          "base": {
            "$value": "{color.form.input.base}",
            "$description": "Paragon default → --pgn-color-form-input-focus-base"
          },
          "bg": {
            "$value": "{color.form.input.bg.base}",
            "$description": "Paragon default → --pgn-color-form-input-focus-bg"
          }
        },
        "placeholder": {
          "$value": "{color.gray.500}",
          "$description": "Placeholder text"
        },
        "group": {
          "addon": {
            "base": {
              "$value": "{color.form.input.base}",
              "$description": "Paragon default → --pgn-color-form-input-group-addon-base"
            },
            "bg": {
              "$value": "{color.gray.100}",
              "$description": "Paragon default → --pgn-color-form-input-group-addon-bg"
            },
            "border": {
              "$value": "{color.form.input.border}",
              "$description": "Paragon default → --pgn-color-form-input-group-addon-border"
            }
          }
        }
      },
      "control": {
        "indicator": {
          "border": {
            "$value": "{color.gray.700}",
            "$description": "Checkbox/radio border"
          },
          "checked": {
            "bg": {
              "base": {
                "$value": "{color.primary.base}",
                "$description": "Checked checkbox/radio fill → primary"
              }
            },
            "border": {
              "base": {
                "$value": "{color.primary.base}",
                "$description": "Checked checkbox/radio border"
              }
            }
          },
          "bg": {
            "base": {
              "$value": "{color.form.input.bg.base}",
              "$description": "Paragon default → --pgn-color-form-control-indicator-bg-base"
            }
          }
        },
        "label": {
          "floating": {
            "text": {
              "modify": [
                {
                  "type": "alpha",
                  "amount": 0.1
                }
              ],
              "$value": "{color.form.input.bg.base}",
              "$description": "Paragon default → --pgn-color-form-control-label-floating-text"
            }
          }
        },
        "switch": {
          "indicator": {
            "checked": {
              "bg": {
                "$value": "{color.success.base}",
                "$description": "Paragon default → --pgn-color-form-control-switch-indicator-checked-bg"
              }
            }
          }
        }
      },
      "feedback": {
        "invalid": {
          "$value": "{color.danger.base}",
          "$description": "Paragon default → --pgn-color-form-feedback-invalid"
        },
        "tooltip": {
          "box-shadow": {
            "focus": {
              "invalid": {
                "modify": [
                  {
                    "type": "alpha",
                    "amount": 0.25
                  }
                ],
                "$value": "{color.form.feedback.invalid}",
                "$description": "Paragon default → --pgn-color-form-feedback-tooltip-box-shadow-focus-invalid"
              },
              "valid": {
                "modify": [
                  {
                    "type": "alpha",
                    "amount": 0.25
                  }
                ],
                "$value": "{color.form.feedback.valid}",
                "$description": "Paragon default → --pgn-color-form-feedback-tooltip-box-shadow-focus-valid"
              }
            }
          }
        },
        "valid": {
          "$value": "{color.success.base}",
          "$description": "Paragon default → --pgn-color-form-feedback-valid"
        }
      }
    },
    "input": {
      "focus": {
        "$value": "{color.primary.base}",
        "$description": "Global input focus → --pgn-color-input-focus"
      }
    }
  }
}
