{
  "$description": "MODAL (light) — component-level color tokens (.modal-content). Same defaults Paragon derives (bg follows page background), now a documented, independently overridable control point.",
  "color": {
    "modal": {
      "content": {
        "bg": { "$value": "{color.surface.base}", "$description": "Modal content bg → --pgn-color-modal-content-bg (follows Layer 1 surface)" },
        "border": { "$value": "{color.black}", "modify": [{ "type": "alpha", "amount": 0.2 }], "$description": "Modal content border → --pgn-color-modal-content-border" }
      },
      "backdrop-bg": { "$value": "{color.black}", "$description": "Modal backdrop → --pgn-color-modal-backdrop-bg" }
    }
  },
  "elevation": {
    "modal": {
      "content": {
        "box-shadow": {
          "sm-up": { "$value": [{ "color": "rgba(0, 0, 0, .15)", "offsetX": "0", "offsetY": "10px", "blur": "20px" }, { "color": "rgba(0, 0, 0, .15)", "offsetX": "0", "offsetY": "8px", "blur": "20px" }], "$description": "Paragon default → --pgn-elevation-modal-content-box-shadow-sm-up" }
        }
      }
    }
  },
  "other": {
    "modal": {
      "opacity": { "$value": ".5", "$description": "Paragon default → --pgn-other-modal-opacity" }
    }
  }
}
