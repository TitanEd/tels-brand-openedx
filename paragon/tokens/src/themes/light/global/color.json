{
  "$type": "color",
  "$description": "LAYER 1 \u2014 Global semantic colors (light). Change color.primary.base once \u2192 buttons, links, tabs, selects, TinyMCE accents. Applied via CSS vars; bridges only rematch selectors.",
  "color": {
    "white": {
      "$value": "#FFFFFF",
      "$description": "UI label: White"
    },
    "black": {
      "$value": "#000000",
      "$description": "UI label: Black"
    },
    "red": {
      "$value": "#C32D3A",
      "$description": "Base red (feeds Danger when linked)"
    },
    "green": {
      "$value": "#178253",
      "$description": "Base green (feeds Success when linked)"
    },
    "blue": {
      "$value": "#23419F",
      "$description": "Base blue"
    },
    "yellow": {
      "$value": "#FFD900",
      "$description": "Base yellow (feeds Warning when linked)"
    },
    "teal": {
      "$value": "#006DAA",
      "$description": "Base teal (feeds Info when linked)"
    },
    "accent": {
      "a": {
        "$value": "#00BBF9",
        "$description": "UI label: Accent A"
      },
      "b": {
        "$value": "#FFEE88",
        "$description": "UI label: Accent B"
      }
    },
    "primary": {
      "500": {
        "actions": {
          "default": "{color.action.default.primary.500}"
        },
        "$value": "{color.primary.base}",
        "$description": "Paragon default \u2192 --pgn-color-primary-500"
      },
      "700": {
        "modify": [
          {
            "type": "mix",
            "otherColor": "black",
            "amount": "0.20"
          }
        ],
        "actions": {
          "default": "{color.action.default.primary.700}"
        },
        "$value": "{color.primary.base}",
        "$description": "Paragon default \u2192 --pgn-color-primary-700"
      },
      "base": {
        "$value": "#EB5939",
        "$description": "LAYER 1 color 1 \u2014 Primary. Change once \u2192 solid/outline/inverse primary buttons, brand (linked), links, tabs."
      },
      "light": {
        "$value": "#F2F7F8",
        "$description": "Primary light surface"
      },
      "hover": {
        "$value": "#BC472E",
        "$description": "Marketing primary hover/darker shade \u2192 --pgn-color-primary-hover (Lovable --brand-primary-hover)"
      },
      "soft": {
        "$value": "#FFF1ED",
        "$description": "Marketing primary tint surface (badges, icon chips, soft CTAs) \u2192 --pgn-color-primary-soft (Lovable --brand-primary-soft)"
      }
    },
    "secondary": {
      "base": {
        "$value": "#273F2F",
        "$description": "LAYER 1 color 2 \u2014 Secondary. Change once \u2192 solid/outline/inverse secondary buttons and icon-secondary."
      },
      "light": {
        "$value": "#F3F5F4",
        "$description": "Secondary light surface"
      }
    },
    "brand": {
      "base": {
        "$value": "{color.primary.base}",
        "$description": "Brand hue follows Layer 1 Primary. Override here only if brand must diverge from primary."
      }
    },
    "surface": {
      "base": {
        "$value": "{color.white}",
        "$description": "LAYER 1 \u2014 Surface (raised containers on the page bg). \u2192 --pgn-color-surface-base. Feeds modal content, dropdown menu and DataTable backgrounds."
      }
    },
    "success": {
      "100": {
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.94"
          }
        ],
        "actions": {
          "default": "{color.action.default.success.100}"
        },
        "$value": "{color.success.base}",
        "$description": "Paragon default \u2192 --pgn-color-success-100"
      },
      "base": {
        "$value": "{color.green}",
        "$description": "UI label: Success"
      }
    },
    "info": {
      "base": {
        "$value": "{color.teal}",
        "$description": "UI label: Info"
      }
    },
    "warning": {
      "100": {
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.94"
          }
        ],
        "actions": {
          "default": "{color.action.default.warning.100}"
        },
        "$value": "{color.warning.base}",
        "$description": "Paragon default \u2192 --pgn-color-warning-100"
      },
      "200": {
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.75"
          }
        ],
        "actions": {
          "default": "{color.action.default.warning.200}"
        },
        "$value": "{color.warning.base}",
        "$description": "Paragon default \u2192 --pgn-color-warning-200"
      },
      "500": {
        "actions": {
          "default": "{color.action.default.warning.500}"
        },
        "$value": "{color.warning.base}",
        "$description": "Paragon default \u2192 --pgn-color-warning-500"
      },
      "base": {
        "$value": "{color.yellow}",
        "$description": "UI label: Warning"
      }
    },
    "danger": {
      "100": {
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.94"
          }
        ],
        "actions": {
          "default": "{color.action.default.danger.100}"
        },
        "$value": "{color.danger.base}",
        "$description": "Paragon default \u2192 --pgn-color-danger-100"
      },
      "base": {
        "$value": "{color.red}",
        "$description": "UI label: Danger"
      }
    },
    "light": {
      "200": {
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.75"
          }
        ],
        "actions": {
          "default": "{color.action.default.light.200}"
        },
        "$value": "{color.light.base}",
        "$description": "Paragon default \u2192 --pgn-color-light-200"
      },
      "300": {
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.50"
          }
        ],
        "actions": {
          "default": "{color.action.default.light.300}"
        },
        "$value": "{color.light.base}",
        "$description": "Paragon default \u2192 --pgn-color-light-300"
      },
      "base": {
        "$value": "#E1DDDB",
        "$description": "UI label: Light base"
      }
    },
    "dark": {
      "700": {
        "modify": [
          {
            "type": "mix",
            "otherColor": "black",
            "amount": "0.20"
          }
        ],
        "actions": {
          "default": "{color.action.default.dark.700}"
        },
        "$value": "{color.dark.base}",
        "$description": "Paragon default \u2192 --pgn-color-dark-700"
      },
      "base": {
        "$value": "#273F2F",
        "$description": "UI label: Dark base"
      }
    },
    "gray": {
      "100": {
        "actions": {
          "default": "{color.action.default.gray.100}"
        },
        "$value": "#EBEBEB",
        "$description": "Paragon default \u2192 --pgn-color-gray-100"
      },
      "300": {
        "actions": {
          "default": "{color.action.default.gray.300}"
        },
        "$value": "#ADADAD",
        "$description": "Paragon default \u2192 --pgn-color-gray-300"
      },
      "500": {
        "actions": {
          "default": "{color.action.default.gray.500}"
        },
        "$value": "{color.gray.base}",
        "$description": "Paragon default \u2192 --pgn-color-gray-500"
      },
      "700": {
        "actions": {
          "default": "{color.action.default.gray.700}"
        },
        "$value": "#454545",
        "$description": "Paragon default \u2192 --pgn-color-gray-700"
      },
      "base": {
        "$value": "#707070",
        "$description": "UI label: Gray base"
      }
    },
    "text": {
      "base": {
        "$value": "#111827",
        "$description": "UI label: Body text (text-base)"
      },
      "light": {
        "$value": "#515661",
        "$description": "Lighter body text"
      },
      "primary": {
        "$value": "#515661",
        "$description": "Text primary variant"
      },
      "footer": {
        "$value": "#F9FAFB",
        "$description": "Footer body text on the dark footer band (template-1 .tels-footer, color.footer.bg) \u2192 --pgn-color-text-footer"
      },
      "inverse": {
        "$value": "{color.white}",
        "$description": "Text, border or icon on a colored or dark backdrop (solid buttons, inverse buttons, badges, toolbars). White in both modes: in dark mode color.white is the surface color, this one stays white \u2192 --pgn-color-text-inverse"
      },
      "secondary": {
        "$value": "#475467",
        "$description": "Secondary body text \u2192 --pgn-color-text-secondary"
      }
    },
    "chrome": {
      "border": {
        "$value": "#E5E5E5",
        "$description": "Marketing chrome + public page borders (header/footer, cards, form fields, filter pills) \u2192 --pgn-color-chrome-border"
      },
      "surface-subtle": {
        "$value": "#F9FAFB",
        "$description": "Marketing chrome + public page subtle surface (search field bg, alternating section bg) \u2192 --pgn-color-chrome-surface-subtle"
      },
      "surface-warm": {
        "$value": "#F7F5F2",
        "$description": "Public page warm off-white surface for alternating sections \u2192 --pgn-color-chrome-surface-warm (Lovable --surface-warm)"
      },
      "text-muted": {
        "$value": "#98A2B3",
        "$description": "Marketing chrome muted text/icons \u2192 --pgn-color-chrome-text-muted"
      }
    },
    "marketing": {
      "accent": {
        "$value": "#444CE7",
        "$description": "Public page secondary accent (insight/tag highlights) \u2192 --pgn-color-marketing-accent (Lovable --brand-accent)"
      }
    },
    "footer": {
      "bg": {
        "$value": "#1D2939",
        "$description": "Site footer background \u2192 --pgn-color-footer-bg"
      },
      "link": {
        "$value": "#D0D5DD",
        "$description": "Footer link color \u2192 --pgn-color-footer-link"
      },
      "muted": {
        "$value": "#98A2B3",
        "$description": "Footer muted / copyright text \u2192 --pgn-color-footer-muted"
      },
      "border": {
        "$value": "#344054",
        "$description": "Footer dividers and social rings \u2192 --pgn-color-footer-border"
      }
    }
  }
}
