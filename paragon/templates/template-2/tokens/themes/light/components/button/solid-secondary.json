{
  "$description": "SOLID SECONDARY only — class: .btn.btn-secondary. Outline lives in outline-secondary.json (do not duplicate here). Hover/active: Paragon defaults — do not override here.",
  "color": {
    "btn": {
      "bg": {
        "secondary": {
          "$value": "{color.secondary.base}",
          "$description": "Solid secondary background → --pgn-color-btn-bg-secondary"
        }
      },
      "text": {
        "secondary": {
          "$value": "#FFFFFF",
          "modify": null,
          "$description": "Solid secondary text → --pgn-color-btn-text-secondary"
        }
      },
      "border": {
        "secondary": {
          "$value": "{color.btn.bg.secondary}",
          "$description": "Solid secondary border → --pgn-color-btn-border-secondary"
        }
      }
    }
  }
}
