{
  "name": "@titaned/tels-brand-openedx",
  "version": "0.1.0",
  "private": true,
  "description": "TitanEd Open edX Ulmo brand package — global design tokens + component overrides (light/dark). Built on base Open edX brand-openedx.",
  "scripts": {
    "build-tokens": "npm run build-tokens:light && npm run build-tokens:dark",
    "build-tokens:light": "paragon build-tokens --source ./paragon/tokens/src/ --build-dir ./paragon/build -t light --verbose",
    "build-tokens:dark": "paragon build-tokens --source ./paragon/tokens/src/ --build-dir ./paragon/build -t dark --base-paragon-theme light --verbose",
    "build-scss": "paragon build-scss --corePath ./paragon/core.scss --themesPath ./paragon/build/themes",
    "build": "make build",
    "build:watch": "nodemon --ignore dist --ignore paragon/build -x \"make build\"",
    "serve": "node scripts/theme-server.js",
    "preview": "node scripts/preview-server.js",
    "paragon:help": "paragon help",
    "validate": "node scripts/validate-tokens.js",
    "validate:strict": "node scripts/validate-tokens.js --strict",
    "validate:baseline": "node scripts/validate-tokens.js --update-baseline",
    "sync-dark-tokens": "node scripts/sync-dark-tokens.js",
    "hooks:install": "node scripts/install-git-hooks.js",
    "prepare": "node scripts/install-git-hooks.js"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@openedx/paragon": "^23.0.0",
    "esbuild": "^0.25.12",
    "nodemon": "^3.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TitanEd/tels-brand-openedx.git"
  }
}
